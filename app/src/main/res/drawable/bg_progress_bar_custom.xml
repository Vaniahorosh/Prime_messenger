<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/prime_progress_track_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/prime_progress_track_border" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="4dp" />
                <gradient
                    android:angle="0"
                    android:startColor="@color/prime_progress_start"
                    android:endColor="@color/prime_progress_end" />
            </shape>
        </clip>
    </item>
</layer-list>
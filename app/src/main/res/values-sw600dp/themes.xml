<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- On tablets/foldables (sw600dp), disable windowIsTranslucent and use solid prime_base background
         so WindowManager never renders translucent desktop wallpaper during activity creation/transitions. -->
    <style name="Theme.Prime.Swipe" parent="Theme.Prime">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/prime_base</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>

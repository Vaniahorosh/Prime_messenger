<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Widget.Material3.CardView.Elevated.Custom" parent="Widget.Material3.CardView.Elevated">
        <item name="strokeColor">#334155</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cardBackgroundColor">#1E293B</item>
    </style>

    <style name="Theme.Prime" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/prime_brand</item>
        <item name="colorAccent">@color/prime_brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/prime_brand_alpha_80</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/prime_brand</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/prime_search_bg</item>
        <item name="colorOnSecondaryContainer">@color/prime_text_primary</item>
        <item name="android:windowBackground">@color/prime_base</item>
        <item name="android:colorBackground">@color/prime_base</item>
        <item name="colorSurface">@color/prime_base</item>
        <item name="colorOnSurface">@color/prime_text_primary</item>
        <item name="colorSurfaceVariant">@color/prime_surface</item>
        <item name="colorOnSurfaceVariant">@color/prime_text_secondary</item>
        <item name="colorSurfaceContainerHigh">@color/chat_island_bg</item>
        <item name="colorOutline">@color/prime_divider</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated.Custom</item>
        <item name="materialAlertDialogTheme">@style/Theme.Prime.AlertDialog</item>
    </style>

    <style name="Widget.MaterialComponents.TextInputLayout.OutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">#334155</item>
    </style>

    <style name="Theme.Prime.Swipe" parent="Theme.Prime">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <style name="SquareFABShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Rounded15PercentImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24%</item>
    </style>

    <style name="Theme.Prime.PhotoViewer" parent="Theme.Prime.Swipe">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Theme Overlays for Custom Color Accents (Dark Theme) -->
    <style name="ThemeOverlay.Prime.Emerald" parent="">
        <item name="colorPrimary">#26A69A</item>
        <item name="colorAccent">#26A69A</item>
        <item name="colorPrimaryContainer">#CC26A69A</item>
        <item name="colorSecondary">#26A69A</item>
    </style>

    <style name="ThemeOverlay.Prime.Purple" parent="">
        <item name="colorPrimary">#B388FF</item>
        <item name="colorAccent">#B388FF</item>
        <item name="colorPrimaryContainer">#CCB388FF</item>
        <item name="colorSecondary">#B388FF</item>
    </style>

    <style name="ThemeOverlay.Prime.Amber" parent="">
        <item name="colorPrimary">#FFB74D</item>
        <item name="colorAccent">#FFB74D</item>
        <item name="colorPrimaryContainer">#CCFFB74D</item>
        <item name="colorSecondary">#FFB74D</item>
    </style>

    <style name="ThemeOverlay.Prime.Ruby" parent="">
        <item name="colorPrimary">#FF5252</item>
        <item name="colorAccent">#FF5252</item>
        <item name="colorPrimaryContainer">#CCFF5252</item>
        <item name="colorSecondary">#FF5252</item>
    </style>

    <style name="ThemeOverlay.Prime.Cyan" parent="">
        <item name="colorPrimary">#4DD0E1</item>
        <item name="colorAccent">#4DD0E1</item>
        <item name="colorPrimaryContainer">#CC4DD0E1</item>
        <item name="colorSecondary">#4DD0E1</item>
    </style>

    <style name="ThemeOverlay.Prime.Pink" parent="">
        <item name="colorPrimary">#FF4081</item>
        <item name="colorAccent">#FF4081</item>
        <item name="colorPrimaryContainer">#CCFF4081</item>
        <item name="colorSecondary">#FF4081</item>
    </style>
</resources>

<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Prime" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/prime_background_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/prime_button_teal</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">#121212</item>
        <item name="android:colorBackground">#121212</item>
        <item name="colorSurface">#121212</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">#49454F</item>
        <item name="colorOnSurfaceVariant">#CAC4D0</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Prime.Swipe" parent="Theme.Prime">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="SquareFABShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Rounded15PercentImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15%</item>
    </style>

    <style name="Theme.Prime.PhotoViewer" parent="Theme.Prime.Swipe">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
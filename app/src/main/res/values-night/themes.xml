<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Widget.Material3.CardView.Elevated.Custom" parent="Widget.Material3.CardView.Elevated">
        <item name="strokeColor">#334155</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cardBackgroundColor">#1E293B</item>
    </style>

    <style name="Theme.Prime" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/prime_brand</item>
        <item name="colorAccent">@color/prime_brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/prime_brand</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/prime_base</item>
        <item name="android:colorBackground">@color/prime_base</item>
        <item name="colorSurface">@color/prime_base</item>
        <item name="colorOnSurface">@color/prime_text_primary</item>
        <item name="colorSurfaceVariant">@color/prime_surface</item>
        <item name="colorOnSurfaceVariant">@color/prime_text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated.Custom</item>
    </style>

    <style name="Widget.MaterialComponents.TextInputLayout.OutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">#334155</item>
    </style>

    <style name="Theme.Prime.Swipe" parent="Theme.Prime">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="SquareFABShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Rounded15PercentImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15%</item>
    </style>

    <style name="Theme.Prime.PhotoViewer" parent="Theme.Prime.Swipe">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>

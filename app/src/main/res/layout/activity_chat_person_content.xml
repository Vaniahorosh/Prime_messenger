<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/prime_base">

    <!-- Локальные анимированные обои из Material фигур и логотипа -->
    <com.messenger.prime.MaterialShapesWallpaperView
        android:id="@+id/vWallpaperBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Градиентный туман в области статус-бара -->
    <View
        android:id="@+id/vTopGradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 1. Список сообщений (фоновый слой на весь экран) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="88dp"
        android:paddingEnd="8dp"
        android:paddingBottom="96dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Градиентный туман в области системной навигации -->
    <View
        android:id="@+id/vBottomGradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 2. Верхний парящий островок (Floating Glass Header) -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_floating_island"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                tools:ignore="HardcodedText"
                android:contentDescription="Назад"
                android:src="@drawable/ic_arrow_back"
                android:transitionName="transition_back_btn"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/prime_text_primary" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivChatAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/Rounded15PercentImageView" />

            <View
                android:id="@+id/viewOnlineStatus"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:visibility="gone"
                android:background="@android:color/transparent"
                app:layout_constraintBottom_toBottomOf="@+id/ivChatAvatar"
                app:layout_constraintEnd_toEndOf="@+id/ivChatAvatar"
                android:layout_marginEnd="-2dp"
                android:layout_marginBottom="-2dp" />

            <TextView
                android:id="@+id/tvChatName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Имя контакта"
                android:textColor="@color/prime_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tvChatStatus"
                app:layout_constraintEnd_toStartOf="@id/ivChatAvatar"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tvChatStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Ожидание подключения..."
                android:textColor="@color/prime_text_secondary"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivChatAvatar"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintTop_toBottomOf="@id/tvChatName" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </eightbitlab.com.blurview.BlurView>

    <!-- Плавающая плашка даты -->
    <TextView
        android:id="@+id/tvFloatingDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:alpha="0"
        android:background="@drawable/bg_date_bubble"
        android:clickable="true"
        android:focusable="true"
        android:elevation="6dp"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        tools:text="12 марта"
        android:textColor="@color/chat_date_bubble_text"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Кнопка прокрутки вниз -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabScrollToBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:alpha="0"
        tools:ignore="HardcodedText"
        android:contentDescription="Прокрутить вниз"
        android:elevation="10dp"
        android:rotation="-90"
        android:src="@drawable/ic_arrow_back"
        android:visibility="gone"
        app:backgroundTint="@color/prime_brand"
        app:fabCustomSize="44dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/white" />

    <!-- 3. Нижний парящий контейнер (Floating Glass Footer) -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:elevation="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Кнопка подключения (внизу) -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/layoutConnectAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_floating_island"
            android:outlineProvider="background"
            android:clipToOutline="true"
            android:padding="8dp"
            android:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrimeConnect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/prime_brand"
                android:text="⚡ Соединиться"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="22dp" />
        </eightbitlab.com.blurview.BlurView>

        <!-- Строка ввода (скрыта до подключения) -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/layoutInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_floating_island"
            android:outlineProvider="background"
            android:clipToOutline="true"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- Плавающая панель прогресса отправки / передачи -->
            <LinearLayout
                android:id="@+id/layoutSendingProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pending_attachment"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/snakeSendingProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:indeterminate="true"
                    app:indicatorColor="#00E676"
                    app:indicatorSize="24dp"
                    app:trackThickness="3dp" />

                <ProgressBar
                    android:id="@+id/pbSendingProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressDrawable="@drawable/bg_progress_bar_custom" />

                <TextView
                    android:id="@+id/tvSendingProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="#80D8FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Передача... 45%" />

                <ImageButton
                    android:id="@+id/btnCancelSendingProgress"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    tools:ignore="HardcodedText"
                    android:contentDescription="Отменить отправку"
                    android:src="@drawable/ic_cancel"
                    app:tint="@color/prime_danger" />
            </LinearLayout>

            <!-- Плавающая панель ожидающих вложений -->
            <LinearLayout
                android:id="@+id/layoutPendingAttachment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pending_attachment"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPendingCards"
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_pending_card" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelPending"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#33154B87"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Отменить все"
                    android:textAllCaps="false"
                    android:textColor="#80D8FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="#4480D8FF"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Плавающая панель режима ответа -->
            <LinearLayout
                android:id="@+id/layoutReplyBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_undo"
                    app:tint="@color/prime_brand" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvReplyBarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Ответ пользователю"
                        android:textColor="@color/prime_brand"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReplyBarText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Текст сообщения..."
                        android:textColor="@color/prime_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnCloseReplyBar"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    tools:ignore="HardcodedText"
                    android:contentDescription="Отменить ответ"
                    android:src="@drawable/ic_cancel"
                    app:tint="@color/prime_danger" />
            </LinearLayout>

            <!-- Плавающая панель режима редактирования -->
            <LinearLayout
                android:id="@+id/layoutEditBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivEditIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/prime_brand" />

                <TextView
                    android:id="@+id/tvEditBarTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    tools:text="Редактирование сообщения"
                    android:textColor="@color/prime_brand"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCloseEditBar"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    tools:ignore="HardcodedText"
                    android:contentDescription="Отменить редактирование"
                    android:src="@drawable/ic_cancel"
                    app:tint="@color/prime_danger" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnAttach"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    tools:ignore="HardcodedText"
                    android:contentDescription="Прикрепить"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="@color/prime_text_secondary" />

                <ImageButton
                    android:id="@+id/btnCancelEdit"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    tools:ignore="HardcodedText"
                    android:contentDescription="Отменить"
                    android:src="@drawable/ic_cancel"
                    android:visibility="gone"
                    app:tint="@color/prime_danger" />

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    tools:ignore="HardcodedText"
                    android:hint="Сообщение..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:paddingStart="10dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/prime_text_primary"
                    android:textColorHint="@color/prime_text_secondary"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnSend"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    tools:ignore="HardcodedText"
                    android:contentDescription="Отправить"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="@color/prime_text_primary" />
            </LinearLayout>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

        <!-- Встроенная панель вложений -->
        <include
            layout="@layout/layout_attachment_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

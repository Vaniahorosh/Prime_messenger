<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLanguageSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/prime_base">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Hero-сцена языка с живым фоном и BlurView-карточкой -->
        <FrameLayout
            android:id="@+id/layoutLanguageHeroStage"
            android:layout_width="0dp"
            android:layout_height="268dp"
            android:tag="do_not_tint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.messenger.prime.MaterialShapesWallpaperView
                android:id="@+id/vLanguageHeroWallpaper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.24" />

            <LinearLayout
                android:id="@+id/layoutLanguageHeroOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurLanguageHeroCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_blur_glass_panel"
                    android:clipToOutline="true"
                    android:outlineProvider="background"
                    tools:targetApi="s">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="224dp"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:id="@+id/ivHeroLanguageIcon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="@string/settings_language_title"
                            android:src="@drawable/ic_language"
                            app:tint="@color/prime_brand" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvHeroLanguageBadgeCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_m3_active_indicator"
                                android:backgroundTint="@color/prime_brand"
                                android:fontFamily="sans-serif-medium"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                tools:text="AUTO" />

                            <TextView
                                android:id="@+id/tvHeroLanguageName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/settings_lang_system"
                                android:textColor="@color/prime_text_primary"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>
            </LinearLayout>
        </FrameLayout>

        <View
            android:id="@+id/vSheetOverlapAnchor"
            android:layout_width="0dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="@id/layoutLanguageHeroStage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <FrameLayout
            android:id="@+id/layoutDetailSheet"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_editor_sheet_top"
            android:clipChildren="true"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/vSheetOverlapAnchor">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollLanguageSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="16dp"
                android:paddingBottom="28dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_max="640dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/settings_language_section_header"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="13sp" />

                        <!-- Вариант 1: Системный -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardLangSystem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/prime_surface"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:minHeight="68dp"
                                android:orientation="horizontal"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="12dp">

                                <ImageView
                                    android:id="@+id/ivLangSystemBadge"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_marginEnd="16dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_settings"
                                    app:tint="@color/prime_brand" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:text="@string/settings_lang_system"
                                        android:textColor="@color/prime_text_primary"
                                        android:textSize="16sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="@string/settings_lang_system_desc"
                                        android:textColor="@color/prime_text_secondary"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <RadioButton
                                    android:id="@+id/rbLangSystem"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:clickable="false"
                                    android:focusable="false" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Вариант 2: Русский -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardLangRussian"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/prime_surface"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:minHeight="68dp"
                                android:orientation="horizontal"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="12dp">

                                <ImageView
                                    android:id="@+id/ivLangRussianBadge"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_marginEnd="16dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_language"
                                    app:tint="@color/prime_brand" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:text="@string/settings_lang_ru"
                                        android:textColor="@color/prime_text_primary"
                                        android:textSize="16sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="@string/settings_lang_ru_desc"
                                        android:textColor="@color/prime_text_secondary"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <RadioButton
                                    android:id="@+id/rbLangRussian"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:clickable="false"
                                    android:focusable="false" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Вариант 3: English -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardLangEnglish"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/prime_surface"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:minHeight="68dp"
                                android:orientation="horizontal"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="12dp">

                                <ImageView
                                    android:id="@+id/ivLangEnglishBadge"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_marginEnd="16dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_globe"
                                    app:tint="@color/prime_brand" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:text="@string/settings_lang_en"
                                        android:textColor="@color/prime_text_primary"
                                        android:textSize="16sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="@string/settings_lang_en_desc"
                                        android:textColor="@color/prime_text_secondary"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <RadioButton
                                    android:id="@+id/rbLangEnglish"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:clickable="false"
                                    android:focusable="false" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Примечание -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardLangInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/prime_surface"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="4dp"
                                android:padding="16dp"
                                android:text="@string/settings_language_note"
                                android:textColor="@color/prime_text_secondary"
                                android:textSize="13sp" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include layout="@layout/include_settings_detail_toolbar" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardWallpaper"
    android:layout_width="110dp"
    android:layout_height="175dp"
    android:layout_marginEnd="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/prime_brand"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Холст предпросмотра обоев -->
        <com.messenger.prime.MaterialShapesWallpaperView
            android:id="@+id/vWallpaperPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Индикатор галочка выбоа -->
        <FrameLayout
            android:id="@+id/layoutSelectionBadge"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circular_mode_active"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_done"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- Затемнение снизу для названия -->
        <View
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_fog_dark" />

        <TextView
            android:id="@+id/tvWallpaperName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingBottom="8dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            tools:text="Полночный" />

    </FrameLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPluginsSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/prime_base">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Hero-сцена плагинов -->
        <FrameLayout
            android:id="@+id/layoutPluginsHeroStage"
            android:layout_width="0dp"
            android:layout_height="232dp"
            android:tag="do_not_tint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/layoutPluginsHeroOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">

                <FrameLayout
                    android:id="@+id/flPluginsHeroBadge"
                    android:layout_width="64dp"
                    android:layout_height="64dp">

                    <ImageView
                        android:id="@+id/ivPluginsHeroIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:contentDescription="Плагины"
                        android:src="@drawable/ic_pipette"
                        android:tag="do_not_tint"
                        app:tint="@color/prime_brand" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvHeroPluginsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:text="Нет добавленных плагинов"
                    android:textColor="@color/prime_text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_editor_input_box"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="Java • Kotlin • Python • JS • JSON"
                    android:textColor="@color/prime_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:id="@+id/vSheetOverlapAnchor"
            android:layout_width="0dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="@id/layoutPluginsHeroStage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <FrameLayout
            android:id="@+id/layoutDetailSheet"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_editor_sheet_top"
            android:clipChildren="true"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/vSheetOverlapAnchor">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollPluginsSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="16dp"
                android:paddingBottom="28dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_max="640dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardPlugins"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/prime_surface"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:id="@+id/ivIconPluginsCard"
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:src="@drawable/ic_pipette"
                                        app:tint="@color/prime_brand" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvTitlePluginsCard"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="sans-serif-medium"
                                            android:text="Управление плагинами"
                                            android:textColor="@color/prime_brand"
                                            android:textSize="16sp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="Локальные скрипты и модули расширения"
                                            android:textColor="@color/prime_text_secondary"
                                            android:textSize="12sp" />
                                    </LinearLayout>

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnAddPlugin"
                                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:contentDescription="Добавить плагин"
                                        android:insetLeft="0dp"
                                        android:insetTop="0dp"
                                        android:insetRight="0dp"
                                        android:insetBottom="0dp"
                                        android:padding="0dp"
                                        android:stateListAnimator="@null"
                                        app:backgroundTint="@color/prime_brand"
                                        app:cornerRadius="20dp"
                                        app:elevation="0dp"
                                        app:icon="@drawable/ic_add"
                                        app:iconGravity="textStart"
                                        app:iconPadding="0dp"
                                        app:iconTint="@color/white"
                                        app:strokeWidth="0dp" />
                                </LinearLayout>

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginVertical="14dp"
                                    android:background="@color/prime_divider" />

                                <TextView
                                    android:id="@+id/tvEmptyPluginsNotice"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:paddingVertical="18dp"
                                    android:text="Нет добавленных плагинов.\nНажмите '+', чтобы добавить файл или создать код."
                                    android:textColor="@color/prime_text_secondary"
                                    android:textSize="13sp" />

                                <LinearLayout
                                    android:id="@+id/containerPluginsList"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include layout="@layout/include_settings_detail_toolbar" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

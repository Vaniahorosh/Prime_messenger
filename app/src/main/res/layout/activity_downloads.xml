<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutDownloadsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/prime_base">

    <!-- Top Fog Background -->
    <View
        android:id="@+id/vTopFog"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_top_fog_dark"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Integrated Glass Header Island -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeaderIsland"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_island_brand"
        android:paddingHorizontal="8dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:contentDescription="Назад"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Center Container (Title or Search) -->
        <FrameLayout
            android:id="@+id/layoutHeaderCenterContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/layoutHeaderActionsContainer"
            app:layout_constraintStart_toEndOf="@+id/btnBack"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/layoutTitleContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Центр загрузок"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvStorageUsage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    tools:text="Собеседники и браузер • 24 МБ" />
            </LinearLayout>

            <EditText
                android:id="@+id/etHeaderSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:gravity="center_vertical"
                android:hint="Поиск файлов и медиа..."
                android:importantForAutofill="no"
                android:imeOptions="actionSearch"
                android:inputType="textNoSuggestions"
                android:maxLength="196"
                android:maxLines="1"
                android:paddingVertical="0dp"
                android:textColor="@color/white"
                android:textColorHint="#80FFFFFF"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Right Side Action Buttons -->
        <LinearLayout
            android:id="@+id/layoutHeaderActionsContainer"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnToggleViewMode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_format_table"
                app:tint="@color/white"
                android:contentDescription="Режим отображения" />

            <ImageButton
                android:id="@+id/btnHeaderSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_search"
                app:tint="@color/white"
                android:contentDescription="Поиск" />

            <ImageButton
                android:id="@+id/btnHeaderSearchClear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_cancel"
                android:visibility="gone"
                app:tint="@color/white"
                android:contentDescription="Закрыть поиск" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Filter Chips Scroll Area -->
    <HorizontalScrollView
        android:id="@+id/scrollCategoryFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeaderIsland">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipAll"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Все"
                android:textSize="13sp"
                app:cornerRadius="19dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipMedia"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:text="Медиа"
                android:textSize="13sp"
                app:cornerRadius="19dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipDocs"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:text="Документы"
                android:textSize="13sp"
                app:cornerRadius="19dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipMusic"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:text="Музыка"
                android:textSize="13sp"
                app:cornerRadius="19dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipUpdates"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:text="Обновления"
                android:textSize="13sp"
                app:cornerRadius="19dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Active Transfers List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvActiveTransfers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:nestedScrollingEnabled="false"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/scrollCategoryFilter"
        tools:listitem="@layout/item_active_transfer"
        tools:visibility="visible" />

    <!-- Downloads List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDownloads"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rvActiveTransfers"
        tools:listitem="@layout/item_download_file_grid" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Загруженных файлов не найдено"
        android:textColor="@color/prime_text_secondary"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollCategoryFilter" />

</androidx.constraintlayout.widget.ConstraintLayout>

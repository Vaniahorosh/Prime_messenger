<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/personInfoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/prime_base"
    tools:context=".PersonInformationActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="40dp">

            <!-- Live Wallpaper Background (Underneath) -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/composeHeaderBackground"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Profile Cover Image (Renders ON TOP of Live Wallpaper) -->
            <ImageView
                android:id="@+id/ivProfileCover"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Content with Photo and Buttons -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerStaticBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="135dp"
                android:paddingBottom="24dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutWithPhoto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:layout_constraintWidth_max="650dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Avatar card in center (Extra Large 210dp, 50/50 overlap) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/photoCard"
                        android:layout_width="210dp"
                        android:layout_height="210dp"
                        app:cardBackgroundColor="@color/glass_white_10"
                        app:cardCornerRadius="38dp"
                        app:cardElevation="8dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ivPhotoCard"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:transitionName="transition_avatar"
                                android:contentDescription="Фото собеседника" />

                            <TextView
                                android:id="@+id/tvAvatarCounter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_date_bubble"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:elevation="10dp"
                                android:alpha="0"
                                android:translationY="-30dp"
                                android:visibility="gone"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                tools:text="1 из 3"
                                tools:visibility="visible"
                                tools:alpha="1"
                                tools:translationY="0dp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tvUserNameWP"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginHorizontal="24dp"
                        android:textColor="@color/prime_text_primary"
                        android:textSize="24sp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:gravity="center"
                        android:transitionName="transition_name"
                        app:layout_constraintTop_toBottomOf="@id/photoCard"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <LinearLayout
                        android:id="@+id/layoutStatusWPContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/tvUserNameWP"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/tvStatusWP"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="в сети"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/ivVersionStatusBadge"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:visibility="gone"
                            android:contentDescription="Статус версии"
                            android:src="@drawable/ic_error"
                            app:tint="@color/prime_warning" />
                    </LinearLayout>

                    <!-- Left Column Action Buttons with Text Labels (Top-most Z-order) -->
                    <LinearLayout
                        android:id="@+id/layoutLeftColumn"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:elevation="16dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        app:layout_constraintEnd_toStartOf="@id/photoCard"
                        app:layout_constraintTop_toTopOf="@id/photoCard"
                        app:layout_constraintBottom_toBottomOf="@id/photoCard">

                        <!-- 1. Button Back -->
                        <LinearLayout
                            android:id="@+id/btnBackLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBack"
                                style="@style/Widget.MaterialComponents.Button.Icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:backgroundTint="@color/glass_white_20"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:transitionName="transition_back_btn"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_arrow_back"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="24dp"
                                app:iconTint="@color/prime_text_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Назад"
                                android:textColor="@color/prime_text_primary"
                                android:alpha="0.8"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <!-- 2. Button View Photo -->
                        <LinearLayout
                            android:id="@+id/btnViewPhotoLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnViewPhoto"
                                style="@style/Widget.MaterialComponents.Button.Icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:backgroundTint="@color/glass_white_20"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_photo"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="24dp"
                                app:iconTint="@color/prime_text_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Просмотр фото"
                                android:textColor="@color/prime_text_primary"
                                android:alpha="0.8"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <!-- 3. Button Reader Mode -->
                        <LinearLayout
                            android:id="@+id/btnReaderModeLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnReaderMode"
                                style="@style/Widget.MaterialComponents.Button.Icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:backgroundTint="@color/glass_white_20"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_book"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="24dp"
                                app:iconTint="@color/prime_text_primary" />

                            <TextView
                                android:id="@+id/tvReaderModeLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Читатель"
                                android:textColor="@color/prime_text_primary"
                                android:alpha="0.8"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <!-- 4. Button Delete Chat -->
                        <LinearLayout
                            android:id="@+id/btnDeleteChatLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDeleteChat"
                                style="@style/Widget.MaterialComponents.Button.Icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:backgroundTint="@color/glass_white_20"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_trash"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="24dp"
                                app:iconTint="@color/prime_danger" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Удалить чат"
                                android:textColor="@color/prime_danger"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/layoutContentSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/headerStaticBlock">

                <!-- Горизонтальный переключатель категорий (Фото и видео | Файлы | GIF | Музыка) -->
                <HorizontalScrollView
                    android:id="@+id/scrollCategoryTabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:scrollbars="none"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="2dp">

                        <!-- Вкладка 1: Фото и видео -->
                        <LinearLayout
                            android:id="@+id/tabPhotoVideo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_date_bubble"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp">

                            <ImageView
                                android:id="@+id/ivTabPhotoIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="Фото и видео"
                                android:src="@drawable/ic_photo"
                                app:tint="@color/prime_brand" />

                            <TextView
                                android:id="@+id/tvTabPhotoTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Фото и видео"
                                android:textColor="@color/prime_brand"
                                android:textSize="13.5sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tvTabPhotoCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:textColor="@color/prime_brand"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="0" />
                        </LinearLayout>

                        <!-- Вкладка 2: Файлы -->
                        <LinearLayout
                            android:id="@+id/tabFiles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_date_bubble"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp">

                            <ImageView
                                android:id="@+id/ivTabFilesIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="Файлы"
                                android:src="@drawable/ic_file"
                                app:tint="@color/prime_text_secondary" />

                            <TextView
                                android:id="@+id/tvTabFilesTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Файлы"
                                android:textColor="@color/prime_text_secondary"
                                android:textSize="13.5sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tvTabFilesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:textColor="@color/prime_text_secondary"
                                android:textSize="12sp"
                                tools:text="0" />
                        </LinearLayout>

                        <!-- Вкладка 3: GIF -->
                        <LinearLayout
                            android:id="@+id/tabGifs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_date_bubble"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp">

                            <ImageView
                                android:id="@+id/ivTabGifsIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="GIF"
                                android:src="@drawable/ic_gif"
                                app:tint="@color/prime_text_secondary" />

                            <TextView
                                android:id="@+id/tvTabGifsTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="GIF"
                                android:textColor="@color/prime_text_secondary"
                                android:textSize="13.5sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tvTabGifsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:textColor="@color/prime_text_secondary"
                                android:textSize="12sp"
                                tools:text="0" />
                        </LinearLayout>

                        <!-- Вкладка 4: Музыка -->
                        <LinearLayout
                            android:id="@+id/tabMusic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_date_bubble"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp">

                            <ImageView
                                android:id="@+id/ivTabMusicIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="Музыка"
                                android:src="@drawable/ic_music"
                                app:tint="@color/prime_text_secondary" />

                            <TextView
                                android:id="@+id/tvTabMusicTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Музыка"
                                android:textColor="@color/prime_text_secondary"
                                android:textSize="13.5sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tvTabMusicCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:textColor="@color/prime_text_secondary"
                                android:textSize="12sp"
                                tools:text="0" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Блок контента выбранного раздела -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSharedContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/prime_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivSectionHeaderIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="Иконка раздела"
                                android:src="@drawable/ic_photo"
                                app:tint="@color/prime_brand" />

                            <TextView
                                android:id="@+id/tvSectionHeaderTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="Фото и видео"
                                android:textColor="@color/prime_text_primary"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tvSectionHeaderCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/prime_text_secondary"
                                android:textSize="13sp"
                                tools:text="0" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvEmptySection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:padding="16dp"
                            android:text="Нет сохраненных файлов"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvSharedMedia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:visibility="gone"
                            android:nestedScrollingEnabled="false" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvSharedFiles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:visibility="gone"
                            android:nestedScrollingEnabled="false" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvSharedGifs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:visibility="gone"
                            android:nestedScrollingEnabled="false" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvSharedMusic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:visibility="gone"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Floating Blur Toolbar for Person Information -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurStickyToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:visibility="gone"
        android:alpha="0"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <!-- Верхняя строчка: Кнопка назад | Имя пользователя + Статус -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStickyBack"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:backgroundTint="@android:color/transparent"
                    app:elevation="0dp"
                    android:padding="0dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_arrow_back"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/prime_text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStickyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/prime_text_primary"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        tools:text="Имя Собеседника" />

                    <TextView
                        android:id="@+id/tvStickyStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/prime_text_secondary"
                        android:textSize="12sp"
                        tools:text="в сети" />
                </LinearLayout>
            </LinearLayout>

            <!-- Нижняя строчка: Переключатели категорий -->
            <HorizontalScrollView
                android:id="@+id/scrollCategoryTabsSticky"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="2dp">

                    <!-- Вкладка 1: Фото и видео -->
                    <LinearLayout
                        android:id="@+id/tabPhotoVideoSticky"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_date_bubble"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:id="@+id/ivTabPhotoIconSticky"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Фото и видео"
                            android:src="@drawable/ic_photo"
                            app:tint="@color/prime_brand" />

                        <TextView
                            android:id="@+id/tvTabPhotoTitleSticky"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Фото и видео"
                            android:textColor="@color/prime_brand"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTabPhotoCountSticky"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/prime_brand"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="0" />
                    </LinearLayout>

                    <!-- Вкладка 2: Файлы -->
                    <LinearLayout
                        android:id="@+id/tabFilesSticky"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_date_bubble"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:id="@+id/ivTabFilesIconSticky"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Файлы"
                            android:src="@drawable/ic_file"
                            app:tint="@color/prime_text_secondary" />

                        <TextView
                            android:id="@+id/tvTabFilesTitleSticky"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Файлы"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvTabFilesCountSticky"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="11sp"
                            tools:text="0" />
                    </LinearLayout>

                    <!-- Вкладка 3: GIF -->
                    <LinearLayout
                        android:id="@+id/tabGifsSticky"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_date_bubble"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:id="@+id/ivTabGifsIconSticky"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="GIF"
                            android:src="@drawable/ic_gif"
                            app:tint="@color/prime_text_secondary" />

                        <TextView
                            android:id="@+id/tvTabGifsTitleSticky"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="GIF"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvTabGifsCountSticky"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="11sp"
                            tools:text="0" />
                    </LinearLayout>

                    <!-- Вкладка 4: Музыка -->
                    <LinearLayout
                        android:id="@+id/tabMusicSticky"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_date_bubble"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:id="@+id/ivTabMusicIconSticky"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Музыка"
                            android:src="@drawable/ic_music"
                            app:tint="@color/prime_text_secondary" />

                        <TextView
                            android:id="@+id/tvTabMusicTitleSticky"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Музыка"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvTabMusicCountSticky"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="11sp"
                            tools:text="0" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/blurBottomNav"
    android:layout_width="wrap_content"
    android:layout_height="56dp"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_blur_glass_panel"
    android:elevation="14dp"
    android:outlineProvider="background"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="0dp">

        <!-- Item 1: Чаты -->
        <LinearLayout
            android:id="@+id/btnNavChats"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_gravity="center">

                <View
                    android:id="@+id/vNavChatsIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_m3_active_indicator"
                    android:backgroundTint="@color/prime_brand" />

                <ImageView
                    android:id="@+id/ivNavChatsIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_chats" />

                <TextView
                    android:id="@+id/tvNavChatsUnreadBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:minWidth="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-2dp"
                    android:layout_marginEnd="-2dp"
                    android:background="@drawable/bg_nav_unread_badge"
                    android:elevation="6dp"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="3"
                    tools:visibility="visible" />
            </FrameLayout>
        </LinearLayout>

        <!-- Item 2: Устройства -->
        <LinearLayout
            android:id="@+id/btnNavDevices"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_gravity="center">

                <View
                    android:id="@+id/vNavDevicesIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_m3_active_indicator"
                    android:backgroundTint="@color/prime_brand" />

                <ImageView
                    android:id="@+id/ivNavDevicesIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_devices" />
            </FrameLayout>
        </LinearLayout>

        <!-- Item 3: AI Чат -->
        <LinearLayout
            android:id="@+id/btnNavAi"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_gravity="center">

                <View
                    android:id="@+id/vNavAiIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@drawable/bg_m3_active_indicator"
                    android:backgroundTint="@color/prime_brand" />

                <ImageView
                    android:id="@+id/ivNavAiIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_prime_ai" />
            </FrameLayout>
        </LinearLayout>

        <!-- Item 3: Поиск -->
        <LinearLayout
            android:id="@+id/btnNavSearch"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_gravity="center">

                <View
                    android:id="@+id/vNavSearchIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_m3_active_indicator"
                    android:backgroundTint="@color/prime_brand" />

                <ImageView
                    android:id="@+id/ivNavSearchIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search" />
            </FrameLayout>
        </LinearLayout>

        <!-- Item: Загрузки -->
        <LinearLayout
            android:id="@+id/btnNavDownloads"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_gravity="center">

                <View
                    android:id="@+id/vNavDownloadsIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_m3_active_indicator"
                    android:backgroundTint="@color/prime_brand" />

                <ImageView
                    android:id="@+id/ivNavDownloadsIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_download" />
            </FrameLayout>
        </LinearLayout>

        <!-- Item 4: Профиль -->
        <LinearLayout
            android:id="@+id/btnNavProfile"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_gravity="center">

                <View
                    android:id="@+id/vNavProfileIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_m3_active_indicator"
                    android:backgroundTint="@color/prime_brand" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivNavProfileAvatar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</eightbitlab.com.blurview.BlurView>
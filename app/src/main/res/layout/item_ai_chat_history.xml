<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/containerSessionItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_date_bubble"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <!-- Active Chat Status Icon -->
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp">

        <ImageView
            android:id="@+id/ivSessionIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_circular_mode_active"
            android:backgroundTint="@color/prime_brand"
            android:padding="8dp"
            android:src="@drawable/ic_prime_ai"
            app:tint="@color/white"
            android:contentDescription="Иконка чата" />

        <!-- Checkmark Badge for Currently Active Chat -->
        <ImageView
            android:id="@+id/ivActiveBadge"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_circular_mode_active"
            android:backgroundTint="@color/prime_brand"
            android:padding="2dp"
            android:src="@drawable/ic_done"
            app:tint="@color/white"
            android:visibility="gone"
            tools:visibility="visible"
            android:contentDescription="Активный чат" />
    </FrameLayout>

    <!-- Chat Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSessionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/prime_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Вопрос по Kotlin Coroutines" />

        <TextView
            android:id="@+id/tvSessionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/prime_text_secondary"
            android:textSize="11sp"
            tools:text="● 12 сообщений • Сегодня, 14:20" />
    </LinearLayout>

    <!-- Delete Chat Button -->
    <ImageView
        android:id="@+id/btnDeleteChatSession"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="7dp"
        android:src="@drawable/ic_trash"
        app:tint="@color/prime_text_secondary"
        android:contentDescription="Удалить чат" />

</LinearLayout>
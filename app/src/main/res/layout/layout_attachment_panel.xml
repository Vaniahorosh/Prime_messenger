<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutAttachmentPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_island"
    android:outlineProvider="background"
    android:clipToOutline="true"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp"
    android:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Основная область содержимого раздела -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Верхний фиксатор перетягивания -->
            <View
                android:id="@+id/vAttachmentDragHandle"
                android:layout_width="38dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"
                android:alpha="0.4"
                android:background="@drawable/bg_date_bubble" />

            <!-- Контейнер для 4-х основных разделов -->
            <FrameLayout
                android:id="@+id/layoutSectionsContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="380dp">

                <!-- Раздел 0: Фото и видео Галерея -->
                <LinearLayout
                    android:id="@+id/layoutSectionPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvGalleryGrid"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:paddingBottom="16dp" />

                        <TextView
                            android:id="@+id/tvGalleryEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Нет фото и видео"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenSystemGallery"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="0dp"
                        android:text="Выбрать в галерее"
                        android:textColor="@color/prime_brand"
                        android:textSize="12sp"
                        app:cornerRadius="19dp"
                        app:icon="@drawable/ic_photo"
                        app:iconSize="16dp"
                        app:iconTint="@color/prime_brand"
                        app:strokeColor="@color/prime_divider"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Раздел 1: Файлы -->
                <LinearLayout
                    android:id="@+id/layoutSectionFiles"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvFilesGrid"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:paddingBottom="16dp" />

                        <TextView
                            android:id="@+id/tvFilesEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Нет файлов (до 2 ГБ)"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenSystemFileManager"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="0dp"
                        android:text="Открыть файловый менеджер"
                        android:textColor="@color/prime_brand"
                        android:textSize="12sp"
                        app:cornerRadius="19dp"
                        app:icon="@drawable/ic_file"
                        app:iconSize="16dp"
                        app:iconTint="@color/prime_brand"
                        app:strokeColor="@color/prime_divider"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Раздел 2: GIF -->
                <LinearLayout
                    android:id="@+id/layoutSectionCamera"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Loading Spinner -->
                    <com.messenger.prime.PrimeWaterLoadingView
                        android:id="@+id/pbGifLoading"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <!-- Tenor GIFs Grid -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvTenorGifs"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:paddingBottom="16dp"
                            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                            app:spanCount="2" />

                        <TextView
                            android:id="@+id/tvGifEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="GIF не найдены. Выберите из галереи"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Нижняя строка: выбор из галереи и поиск -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="6dp"
                        android:paddingBottom="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickGifFromGallery"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="0dp"
                            android:text="Из галереи"
                            android:textColor="@color/prime_brand"
                            android:textSize="12sp"
                            app:cornerRadius="19dp"
                            app:strokeColor="@color/prime_divider"
                            app:strokeWidth="1dp" />

                        <EditText
                            android:id="@+id/etGifSearch"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_search_input"
                            android:hint="Поиск GIF..."
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingHorizontal="12dp"
                            android:textColor="@color/prime_text_primary"
                            android:textColorHint="@color/prime_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Раздел 3: Музыка -->
                <LinearLayout
                    android:id="@+id/layoutSectionMusic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Переключатели подкатегорий -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMusicTabDevice"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="0dp"
                            android:text="На устройстве"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            app:backgroundTint="@color/prime_brand"
                            app:cornerRadius="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMusicTabSaved"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="0dp"
                            android:text="Сохраненные"
                            android:textColor="@color/prime_brand"
                            android:textSize="11sp"
                            app:cornerRadius="16dp"
                            app:strokeColor="@color/prime_divider"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvMusicGrid"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:paddingBottom="16dp"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                        <TextView
                            android:id="@+id/tvMusicEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Музыка не найдена"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenSystemAudioPicker"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="0dp"
                        android:text="Выбрать аудиофайл"
                        android:textColor="@color/prime_brand"
                        android:textSize="12sp"
                        app:cornerRadius="19dp"
                        app:icon="@drawable/ic_music"
                        app:iconSize="16dp"
                        app:iconTint="@color/prime_brand"
                        app:strokeColor="@color/prime_divider"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

        <!-- Нижний островок с 4 главными разделами и фиксированной кнопкой отправки строго по правому нижнему углу -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <HorizontalScrollView
                android:id="@+id/hsvAttachmentTabs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_date_bubble"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <!-- Раздел 1: Фото и видео -->
                    <LinearLayout
                        android:id="@+id/layoutModePhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp">

                        <FrameLayout
                            android:id="@+id/vModePhotoBg"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circular_mode_active">

                            <ImageView
                                android:id="@+id/ivModePhotoIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="Фото и видео"
                                android:src="@drawable/ic_photo" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvModePhotoLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Фото и видео"
                            android:textColor="@color/prime_brand"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Раздел 2: Файлы -->
                    <LinearLayout
                        android:id="@+id/layoutModeFiles"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp">

                        <FrameLayout
                            android:id="@+id/vModeFilesBg"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circular_mode_idle">

                            <ImageView
                                android:id="@+id/ivModeFilesIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="Файлы"
                                android:src="@drawable/ic_file"
                                app:tint="@color/prime_text_secondary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvModeFilesLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Файлы"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Раздел 3: GIF -->
                    <LinearLayout
                        android:id="@+id/layoutModeCamera"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp">

                        <FrameLayout
                            android:id="@+id/vModeCameraBg"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circular_mode_idle">

                            <ImageView
                                android:id="@+id/ivModeCameraIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="GIF"
                                android:src="@drawable/ic_prime_gif"
                                app:tint="@color/prime_text_secondary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvModeCameraLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="GIF"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Раздел 4: Музыка -->
                    <LinearLayout
                        android:id="@+id/layoutModeMusic"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp">

                        <FrameLayout
                            android:id="@+id/vModeMusicBg"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circular_mode_idle">

                            <ImageView
                                android:id="@+id/ivModeMusicIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="Музыка"
                                android:src="@drawable/ic_music"
                                app:tint="@color/prime_text_secondary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvModeMusicLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Музыка"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Фиксированная кнопка подтверждения строго по правому нижнему углу -->
            <FrameLayout
                android:id="@+id/layoutConfirmContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnConfirmAttachment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Отправить"
                    android:src="@drawable/ic_send"
                    app:backgroundTint="@color/prime_brand"
                    app:elevation="4dp"
                    app:fabCustomSize="48dp"
                    app:maxImageSize="22dp"
                    app:tint="@color/white" />

                <!-- Счётчик выбранных файлов -->
                <TextView
                    android:id="@+id/tvConfirmBadgeCounter"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-2dp"
                    android:layout_marginEnd="-2dp"
                    android:alpha="1.0"
                    android:background="@drawable/bg_date_bubble"
                    android:backgroundTint="#FFFFFFFF"
                    android:elevation="8dp"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/prime_brand"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

        </FrameLayout>

    </LinearLayout>
</eightbitlab.com.blurview.BlurView>

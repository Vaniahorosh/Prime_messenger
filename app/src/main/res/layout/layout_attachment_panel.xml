<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutAttachmentPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_island"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp"
    android:visibility="gone">

    <!-- Mode Selection Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <!-- Mode 1: Камера -->
        <LinearLayout
            android:id="@+id/layoutModeCamera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/vModeCameraBg"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circular_mode_active">

                <ImageView
                    android:id="@+id/ivModeCameraIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="Камера"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/prime_brand" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvModeCameraLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Камера"
                android:textColor="@color/prime_brand"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mode 2: Фото -->
        <LinearLayout
            android:id="@+id/layoutModePhoto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/vModePhotoBg"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circular_mode_idle">

                <ImageView
                    android:id="@+id/ivModePhotoIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="Фото"
                    android:src="@drawable/ic_photo"
                    app:tint="@color/prime_text_secondary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvModePhotoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Фото"
                android:textColor="@color/prime_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Mode 3: Файлы -->
        <LinearLayout
            android:id="@+id/layoutModeFiles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/vModeFilesBg"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circular_mode_idle">

                <ImageView
                    android:id="@+id/ivModeFilesIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="Файлы"
                    android:src="@drawable/ic_file"
                    app:tint="@color/prime_text_secondary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvModeFilesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Файлы"
                android:textColor="@color/prime_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Content Sections Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="230dp">

        <!-- Section 1: Камера -->
        <LinearLayout
            android:id="@+id/layoutSectionCamera"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnCameraPhoto"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/prime_brand"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Фото"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/prime_brand" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Сделать фото"
                        android:textColor="@color/prime_brand"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnCameraVideo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginStart="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/prime_brand"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Видео"
                        android:src="@drawable/ic_video"
                        app:tint="@color/prime_brand" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Записать видео"
                        android:textColor="@color/prime_brand"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Section 2: Фото & Видео Галерея -->
        <LinearLayout
            android:id="@+id/layoutSectionPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSystemGallery"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="6dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="0dp"
                android:text="Выбрать в галерее"
                android:textColor="@color/prime_brand"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_photo"
                app:iconSize="16dp"
                app:iconTint="@color/prime_brand"
                app:strokeColor="@color/prime_brand"
                app:strokeWidth="1dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvGalleryGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false" />

                <TextView
                    android:id="@+id/tvGalleryEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Нет фото и видео"
                    android:textColor="@color/prime_text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Section 3: Файлы -->
        <LinearLayout
            android:id="@+id/layoutSectionFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSystemFileManager"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="6dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="0dp"
                android:text="Открыть файловый менеджер"
                android:textColor="@color/prime_brand"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_file"
                app:iconSize="16dp"
                app:iconTint="@color/prime_brand"
                app:strokeColor="@color/prime_brand"
                app:strokeWidth="1dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFilesGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false" />

                <TextView
                    android:id="@+id/tvFilesEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Нет файлов (до 2 ГБ)"
                    android:textColor="@color/prime_text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

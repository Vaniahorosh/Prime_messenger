<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurHeaderMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_island"
        android:outlineProvider="background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="12dp">

            <!-- Drag handle -->
            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/ic_drag_handle"
                android:backgroundTint="#40FFFFFF" />

            <!-- Title -->
            <TextView
                android:id="@+id/tvMenuTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="12dp"
                android:text="Собеседник"
                android:textColor="@color/prime_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1AFFFFFF"
                android:layout_marginBottom="8dp"/>

            <!-- Item 1: Profile -->
            <LinearLayout
                android:id="@+id/btnMenuProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/prime_brand" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Профиль"
                    android:textColor="@color/prime_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-regular" />
            </LinearLayout>

            <!-- Item: To Top -->
            <LinearLayout
                android:id="@+id/btnMenuToTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_up"
                    app:tint="@color/prime_brand" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="В начало"
                    android:textColor="@color/prime_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-regular" />
            </LinearLayout>

            <!-- Item: Search -->
            <LinearLayout
                android:id="@+id/btnMenuSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/prime_brand" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Поиск по чату"
                    android:textColor="@color/prime_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-regular" />
            </LinearLayout>

            <!-- Item: Change Wallpaper -->
            <LinearLayout
                android:id="@+id/btnMenuWallpaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_photo"
                    app:tint="@color/prime_brand" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Изменить обои"
                    android:textColor="@color/prime_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-regular" />
            </LinearLayout>

            <!-- Item: Mute -->
            <LinearLayout
                android:id="@+id/btnMenuMute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp">

                <ImageView
                    android:id="@+id/ivMuteIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_notifications_off"
                    app:tint="@color/prime_brand" />

                <TextView
                    android:id="@+id/tvMuteText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Отключить звук"
                    android:textColor="@color/prime_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-regular" />
            </LinearLayout>

            <!-- Item: Reader Mode -->
            <LinearLayout
                android:id="@+id/btnMenuReaderMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp">

                <ImageView
                    android:id="@+id/ivReaderModeIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_book"
                    app:tint="@color/prime_brand" />

                <TextView
                    android:id="@+id/tvReaderModeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Режим читателя"
                    android:textColor="@color/prime_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-regular" />
            </LinearLayout>

            <!-- Item: Show Pinned Bar -->
            <LinearLayout
                android:id="@+id/btnMenuShowPinned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_pin"
                    app:tint="@color/prime_brand" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Показать закреп."
                    android:textColor="@color/prime_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-regular" />
            </LinearLayout>

            <!-- Item: Delete Chat -->
            <LinearLayout
                android:id="@+id/btnMenuDelete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_trash"
                    app:tint="@color/prime_danger" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Удалить чат"
                    android:textColor="@color/prime_danger"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-regular" />
            </LinearLayout>

        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurHeaderMenuCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_floating_island"
        android:outlineProvider="background">

        <TextView
            android:id="@+id/btnMenuCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:text="Отмена"
            android:textColor="@color/prime_text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
    </eightbitlab.com.blurview.BlurView>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurDialogCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_island"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvColorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Выбор цвета"
                android:textColor="@color/dialog_title_color"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.messenger.prime.SpectrumView
                android:id="@+id/spectrumView"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:id="@+id/layoutPreviewPipette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewColorPreview"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/ic_person"
                    android:backgroundTint="@color/dialog_title_color" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPipette"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Пипетка"
                    android:textColor="@color/dialog_button_cancel_text"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_pipette"
                    app:iconTint="@color/dialog_button_cancel_text"
                    app:strokeColor="@color/dialog_button_cancel_stroke" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputHex"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="HEX (#RRGGBB)"
                app:boxStrokeColor="@color/dialog_box_stroke"
                app:hintTextColor="@color/dialog_hint_color">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:maxLength="7"
                    android:textColor="@color/dialog_input_text_color" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/layoutRGB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:hint="R"
                    app:boxStrokeColor="@color/dialog_box_stroke"
                    app:hintTextColor="@color/dialog_hint_color">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etR"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textColor="@color/dialog_input_text_color" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:hint="G"
                    app:boxStrokeColor="@color/dialog_box_stroke"
                    app:hintTextColor="@color/dialog_hint_color">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etG"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textColor="@color/dialog_input_text_color" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:hint="B"
                    app:boxStrokeColor="@color/dialog_box_stroke"
                    app:hintTextColor="@color/dialog_hint_color">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textColor="@color/dialog_input_text_color" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyColor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Применить"
                android:textAllCaps="false"
                android:textColor="@color/dialog_button_save_text"
                android:textStyle="bold"
                app:backgroundTint="@color/dialog_button_save_bg"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>
</FrameLayout>

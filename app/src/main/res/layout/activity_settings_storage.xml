<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootStorageSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/prime_base">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Hero-сцена телеметрии памяти и интерактивного графика -->
        <FrameLayout
            android:id="@+id/layoutStorageHeroStage"
            android:layout_width="0dp"
            android:layout_height="248dp"
            android:tag="do_not_tint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/layoutStorageHeroOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivIconStorage"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="Память"
                        android:src="@drawable/ic_file"
                        app:tint="@color/prime_brand" />

                    <TextView
                        android:id="@+id/tvTitleStorage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Память Прайма"
                        android:textColor="@color/prime_brand"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHeroStorageTotalSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:text="0 Б"
                    android:textColor="@color/prime_text_primary"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/tvStorageTotalSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFeatureSettings="tnum"
                    android:text="Подсчет данных..."
                    android:textColor="@color/prime_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_storage_chart_track"
                    android:clipToOutline="true"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/vChartPhotos"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#4285F4" />

                    <View
                        android:id="@+id/vChartVideos"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#9C27B0" />

                    <View
                        android:id="@+id/vChartAudio"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#00BCD4" />

                    <View
                        android:id="@+id/vChartGifs"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#FF9800" />

                    <View
                        android:id="@+id/vChartFiles"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#34A853" />

                    <View
                        android:id="@+id/vChartAvatars"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#E91E63" />

                    <View
                        android:id="@+id/vChartOther"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#9E9E9E" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <View
            android:id="@+id/vSheetOverlapAnchor"
            android:layout_width="0dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="@id/layoutStorageHeroStage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <FrameLayout
            android:id="@+id/layoutDetailSheet"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_editor_sheet_top"
            android:clipChildren="true"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/vSheetOverlapAnchor">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollStorageSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="16dp"
                android:paddingBottom="28dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_max="640dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardStorage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/prime_surface"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="10dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="sans-serif-medium"
                                        android:text="Категории кэша"
                                        android:textColor="@color/prime_text_primary"
                                        android:textSize="16sp" />

                                    <TextView
                                        android:id="@+id/tvSelectAllStorage"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/bg_editor_input_box"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:fontFamily="sans-serif-medium"
                                        android:paddingHorizontal="14dp"
                                        android:paddingVertical="8dp"
                                        android:text="Снять всё"
                                        android:textColor="@color/prime_brand"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginBottom="8dp"
                                    android:background="@color/prime_divider" />

                                <LinearLayout
                                    android:id="@+id/rowStoragePhotos"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?attr/selectableItemBackground"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center_vertical"
                                    android:paddingVertical="10dp">

                                    <CheckBox
                                        android:id="@+id/cbStoragePhotos"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:checked="true"
                                        app:buttonTint="@color/prime_brand" />

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_marginStart="8dp"
                                        android:contentDescription="Фото"
                                        android:src="@drawable/ic_photo"
                                        app:tint="#4285F4" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Фотографии"
                                            android:textColor="@color/prime_text_primary"
                                            android:textSize="15sp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="Вложения из чатов"
                                            android:textColor="@color/prime_text_secondary"
                                            android:textSize="12sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/tvSizePhotos"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:fontFeatureSettings="tnum"
                                        android:text="0 Б"
                                        android:textColor="@color/prime_text_secondary"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/rowStorageVideos"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?attr/selectableItemBackground"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center_vertical"
                                    android:paddingVertical="10dp">

                                    <CheckBox
                                        android:id="@+id/cbStorageVideos"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:checked="true"
                                        app:buttonTint="@color/prime_brand" />

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_marginStart="8dp"
                                        android:contentDescription="Видео"
                                        android:src="@drawable/ic_video"
                                        app:tint="#9C27B0" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Видеозаписи"
                                            android:textColor="@color/prime_text_primary"
                                            android:textSize="15sp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="Файлы и кружочки"
                                            android:textColor="@color/prime_text_secondary"
                                            android:textSize="12sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/tvSizeVideos"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:fontFeatureSettings="tnum"
                                        android:text="0 Б"
                                        android:textColor="@color/prime_text_secondary"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/rowStorageAudio"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?attr/selectableItemBackground"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center_vertical"
                                    android:paddingVertical="10dp">

                                    <CheckBox
                                        android:id="@+id/cbStorageAudio"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:checked="true"
                                        app:buttonTint="@color/prime_brand" />

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_marginStart="8dp"
                                        android:contentDescription="Аудио"
                                        android:src="@drawable/ic_music"
                                        app:tint="#00BCD4" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Аудиосообщения"
                                            android:textColor="@color/prime_text_primary"
                                            android:textSize="15sp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="Голосовые заметки и музыка"
                                            android:textColor="@color/prime_text_secondary"
                                            android:textSize="12sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/tvSizeAudio"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:fontFeatureSettings="tnum"
                                        android:text="0 Б"
                                        android:textColor="@color/prime_text_secondary"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/rowStorageGifs"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?attr/selectableItemBackground"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center_vertical"
                                    android:paddingVertical="10dp">

                                    <CheckBox
                                        android:id="@+id/cbStorageGifs"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:checked="true"
                                        app:buttonTint="@color/prime_brand" />

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_marginStart="8dp"
                                        android:contentDescription="GIF"
                                        android:src="@drawable/ic_gif"
                                        app:tint="#FF9800" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="GIF-анимации"
                                            android:textColor="@color/prime_text_primary"
                                            android:textSize="15sp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="Сохранённые анимации"
                                            android:textColor="@color/prime_text_secondary"
                                            android:textSize="12sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/tvSizeGifs"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:fontFeatureSettings="tnum"
                                        android:text="0 Б"
                                        android:textColor="@color/prime_text_secondary"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/rowStorageFiles"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?attr/selectableItemBackground"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center_vertical"
                                    android:paddingVertical="10dp">

                                    <CheckBox
                                        android:id="@+id/cbStorageFiles"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:checked="true"
                                        app:buttonTint="@color/prime_brand" />

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_marginStart="8dp"
                                        android:contentDescription="Документы"
                                        android:src="@drawable/ic_file"
                                        app:tint="#34A853" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Документы"
                                            android:textColor="@color/prime_text_primary"
                                            android:textSize="15sp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="Текстовые файлы и архивы"
                                            android:textColor="@color/prime_text_secondary"
                                            android:textSize="12sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/tvSizeFiles"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:fontFeatureSettings="tnum"
                                        android:text="0 Б"
                                        android:textColor="@color/prime_text_secondary"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/rowStorageAvatars"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?attr/selectableItemBackground"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center_vertical"
                                    android:paddingVertical="10dp">

                                    <CheckBox
                                        android:id="@+id/cbStorageAvatars"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:checked="true"
                                        app:buttonTint="@color/prime_brand" />

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_marginStart="8dp"
                                        android:contentDescription="Аватары"
                                        android:src="@drawable/ic_person"
                                        app:tint="#E91E63" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Аватары контактов"
                                            android:textColor="@color/prime_text_primary"
                                            android:textSize="15sp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="Загруженные фото профилей"
                                            android:textColor="@color/prime_text_secondary"
                                            android:textSize="12sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/tvSizeAvatars"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:fontFeatureSettings="tnum"
                                        android:text="0 Б"
                                        android:textColor="@color/prime_text_secondary"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/rowStorageCache"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?attr/selectableItemBackground"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center_vertical"
                                    android:paddingVertical="10dp">

                                    <CheckBox
                                        android:id="@+id/cbStorageCache"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:checked="true"
                                        app:buttonTint="@color/prime_brand" />

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_marginStart="8dp"
                                        android:contentDescription="Кэш"
                                        android:src="@drawable/ic_eraser"
                                        app:tint="#9E9E9E" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Системный кэш"
                                            android:textColor="@color/prime_text_primary"
                                            android:textSize="15sp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="Временные файлы и эскизы"
                                            android:textColor="@color/prime_text_secondary"
                                            android:textSize="12sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/tvSizeCache"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:fontFeatureSettings="tnum"
                                        android:text="0 Б"
                                        android:textColor="@color/prime_text_secondary"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnClearStorage"
                                    android:layout_width="match_parent"
                                    android:layout_height="52dp"
                                    android:layout_marginTop="20dp"
                                    android:ellipsize="middle"
                                    android:fontFamily="sans-serif-medium"
                                    android:fontFeatureSettings="tnum"
                                    android:maxLines="1"
                                    android:stateListAnimator="@null"
                                    android:text="Очистить: 0 Б"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="15sp"
                                    app:backgroundTint="@color/prime_brand"
                                    app:cornerRadius="16dp"
                                    app:elevation="0dp"
                                    app:strokeWidth="0dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include layout="@layout/include_settings_detail_toolbar" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

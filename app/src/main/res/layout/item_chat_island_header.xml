<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/islandHeaderItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_island_brand"
    android:padding="8dp"
    android:elevation="2dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivHeaderAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:background="@color/glass_white_10"
        android:src="@drawable/ic_person"
        app:shapeAppearanceOverlay="@style/Rounded15PercentImageView"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextSwitcher
        android:id="@+id/tsHeaderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:inAnimation="@anim/slide_in_top_alpha"
        android:outAnimation="@anim/slide_out_bottom"
        app:layout_constraintBottom_toBottomOf="@+id/ivHeaderAvatar"
        app:layout_constraintEnd_toStartOf="@+id/btnHeaderSearch"
        app:layout_constraintStart_toEndOf="@+id/ivHeaderAvatar"
        app:layout_constraintTop_toTopOf="@+id/ivHeaderAvatar" />

    <ImageButton
        android:id="@+id/btnHeaderSearch"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_search"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>

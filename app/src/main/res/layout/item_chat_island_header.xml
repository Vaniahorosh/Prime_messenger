<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/islandHeaderItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_island_brand"
    android:padding="8dp"
    android:elevation="2dp">

    <FrameLayout
        android:id="@+id/layoutHeaderAvatarContainer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivHeaderAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/glass_white_10"
            android:src="@drawable/ic_person"
            app:shapeAppearanceOverlay="@style/Rounded15PercentImageView" />

        <TextView
            android:id="@+id/tvHeaderInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="П"
            tools:visibility="visible" />
    </FrameLayout>

    <TextSwitcher
        android:id="@+id/tsHeaderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:inAnimation="@anim/slide_in_top_alpha"
        android:outAnimation="@anim/slide_out_bottom"
        app:layout_constraintBottom_toBottomOf="@+id/layoutHeaderAvatarContainer"
        app:layout_constraintEnd_toStartOf="@+id/btnHeaderSearch"
        app:layout_constraintStart_toEndOf="@+id/layoutHeaderAvatarContainer"
        app:layout_constraintTop_toTopOf="@+id/layoutHeaderAvatarContainer" />

    <ImageButton
        android:id="@+id/btnHeaderSearch"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_search"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>

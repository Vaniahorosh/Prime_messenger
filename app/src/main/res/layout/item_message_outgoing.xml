<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        android:id="@+id/tvDateHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_date_bubble"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="@color/chat_date_bubble_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutOutgoingBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="64dp"
        android:background="@drawable/bg_bubble_outgoing"
        android:orientation="vertical"
        android:padding="10dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivMessageImage"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/Rounded16dpImageView" />

        <TextView
            android:id="@+id/tvMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/chat_bubble_outgoing_text"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMessageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chat_bubble_outgoing_time"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/ivMessageStatus"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_done"
                app:tint="@color/chat_bubble_outgoing_time" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutMessageReaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="-6dp"
        android:background="@drawable/bg_floating_island"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="4dp"
        android:visibility="gone">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivReactionAvatar"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageView" />
        <TextView
            android:id="@+id/tvMessageReaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Капсула быстрых действий (Реакции + Редактировать / Удалить) -->
    <LinearLayout
        android:id="@+id/layoutMessageActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_floating_island"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnReactHeart"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="❤️"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnReactFire"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="🔥"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnReactLike"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="👍"
            android:textSize="16sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="4dp"
            android:background="@color/prime_divider" />

        <ImageButton
            android:id="@+id/btnEditMsgAction"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Редактировать"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_edit"
            app:tint="@color/prime_text_primary" />

        <ImageButton
            android:id="@+id/btnDeleteMsgAction"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Удалить"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_cancel"
            app:tint="@color/prime_danger" />
    </LinearLayout>
</LinearLayout>

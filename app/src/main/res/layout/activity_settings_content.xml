<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".SettingsActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="40dp">

            <!-- Шапка с фирменным цветом -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerStaticBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="4dp"
                android:paddingBottom="24dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/composeHeaderBackground"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Режим с ФОТО -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutWithPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Кнопка Назад -->
                    <LinearLayout
                        android:id="@+id/btnBackWPLayout"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBackWP"
                            style="@style/Widget.MaterialComponents.Button.Icon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:backgroundTint="@color/glass_white_20"
                            android:padding="0dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_arrow_back"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="24dp"
                            app:iconTint="@color/white" />
                        <TextView
                            android:id="@+id/tvBackLabelWP"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Назад"
                            android:textColor="@color/white"
                            android:alpha="0.8"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Левая колонка кнопок -->
                    <LinearLayout
                        android:id="@+id/layoutLeftColumn"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/btnBackWPLayout"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:id="@+id/btnChangePhotoWPLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnChangePhotoWP"
                                style="@style/Widget.MaterialComponents.Button.Icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:backgroundTint="@color/glass_white_20"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_add"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="24dp"
                                app:iconTint="@color/white" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Фото"
                                android:textColor="@color/white"
                                android:alpha="0.8"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnLogoutWPLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLogoutWP"
                                style="@style/Widget.MaterialComponents.Button.Icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:backgroundTint="@color/glass_white_20"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_exit_to_app"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="24dp"
                                app:iconTint="@color/prime_danger_light" />
                            <TextView
                                android:id="@+id/tvLogoutWP"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Выход"
                                android:textColor="@color/prime_danger_light"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnExtraSettingsWPLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnExtraSettingsWP"
                                style="@style/Widget.MaterialComponents.Button.Icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:backgroundTint="@color/glass_white_20"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_settings"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="24dp"
                                app:iconTint="@color/white" />
                            <TextView
                                android:id="@+id/tvExtraSettingsWP"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="К Настройкам"
                                android:textColor="@color/white"
                                android:alpha="0.8"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Карточка с фото -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/photoCard"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginEnd="16dp"
                        app:cardBackgroundColor="@color/glass_white_10"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/layoutLeftColumn"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/layoutLeftColumn"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ivPhotoCard"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop" />

                            <View
                                android:id="@+id/viewPhotoInfoGradient"
                                android:layout_width="match_parent"
                                android:layout_height="90dp"
                                android:background="@drawable/bg_photo_info_gradient"
                                app:layout_constraintBottom_toBottomOf="parent" />

                            <!-- Контейнер для текста -->
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/layoutPhotoInternal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <TextView
                                    android:id="@+id/tvUserNameWP"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_marginEnd="16dp"
                                    android:layout_marginBottom="2dp"
                                    android:textColor="@color/white"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:singleLine="true"
                                    android:ellipsize="marquee"
                                    android:marqueeRepeatLimit="marquee_forever"
                                    android:scrollHorizontally="true"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    app:layout_constraintBottom_toTopOf="@+id/tvStatusWP"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent" />

                                <TextView
                                    android:id="@+id/tvStatusWP"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="12dp"
                                    android:text="в сети"
                                    android:textColor="#E6FFFFFF"
                                    android:textSize="12sp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="@+id/tvUserNameWP" />
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Режим БЕЗ фото -->
                <LinearLayout
                    android:id="@+id/layoutNoPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvUserNameStatic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="32dp"
                        android:text="в сети"
                        android:textColor="#E6FFFFFF"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBackNP"
                                style="@style/Widget.MaterialComponents.Button.Icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:backgroundTint="@color/glass_white_20"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_arrow_back"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="24dp"
                                app:iconTint="@color/white" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Назад"
                                android:textColor="@color/white"
                                android:alpha="0.8"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnChangePhotoNP"
                                style="@style/Widget.MaterialComponents.Button.Icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:backgroundTint="@color/glass_white_20"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_add"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="24dp"
                                app:iconTint="@color/white" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Фото"
                                android:textColor="@color/white"
                                android:alpha="0.8"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLogoutNP"
                                style="@style/Widget.MaterialComponents.Button.Icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:backgroundTint="@color/glass_white_20"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_exit_to_app"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="24dp"
                                app:iconTint="@color/prime_danger_light" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Выход"
                                android:textColor="@color/prime_danger_light"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnExtraSettingsNP"
                                style="@style/Widget.MaterialComponents.Button.Icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:backgroundTint="@color/glass_white_20"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_settings"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="24dp"
                                app:iconTint="@color/white" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Настройки"
                                android:textColor="@color/white"
                                android:alpha="0.8"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Общий контейнер для всего контента под шапкой -->
            <LinearLayout
                android:id="@+id/layoutSettingsBodyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/headerStaticBlock">

                <!-- Данные аккаунта -->
                <LinearLayout
                    android:id="@+id/layoutAccountData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginHorizontal="24dp"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/bg_settings_block_gray">

                    <!-- Шапка выпадающего списка -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutAccountHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvAccountHeaderLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Вы в прайме,"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/tvAccountHeaderSummary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/prime_brand"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@id/tvAccountHeaderLabel"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/ivAccountArrow"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <ImageView
                            android:id="@+id/ivAccountArrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_arrow_forward"
                            android:rotation="90"
                            app:tint="@color/prime_brand"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Выпадающий контент -->
                    <LinearLayout
                        android:id="@+id/layoutAccountCollapsible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="@color/prime_divider" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Имя"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputLayoutName"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundColor="@android:color/transparent"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp"
                            app:hintEnabled="false"
                            app:counterEnabled="true"
                            app:counterMaxLength="16"
                            app:startIconTint="@color/prime_brand">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSettingsName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="0dp"
                                android:background="@android:color/transparent"
                                android:hint="Введите имя"
                                android:maxLength="16"
                                android:inputType="textPersonName"
                                android:imeOptions="actionNext"
                                android:singleLine="true"
                                android:textColor="@color/prime_brand"
                                android:textStyle="bold" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="@color/prime_divider" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Логин"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputLayoutLogin"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundColor="@android:color/transparent"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp"
                            app:hintEnabled="false"
                            app:counterEnabled="true"
                            app:counterMaxLength="15"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/prime_brand"
                            app:startIconTint="@color/prime_brand">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSettingsLogin"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="0dp"
                                android:background="@android:color/transparent"
                                android:hint="Введите логин"
                                android:maxLength="15"
                                android:digits="abcdefghijklmnopqrstuvwxyz0123456789_"
                                android:inputType="textPassword"
                                android:imeOptions="actionNext"
                                android:singleLine="true"
                                android:textColor="@color/prime_brand"
                                android:textStyle="bold" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="@color/prime_divider" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Пароль"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputLayoutPassword"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundColor="@android:color/transparent"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp"
                            app:hintEnabled="false"
                            app:counterEnabled="true"
                            app:counterMaxLength="32"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/prime_brand">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSettingsPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="0dp"
                                android:background="@android:color/transparent"
                                android:hint="Введите пароль"
                                android:maxLength="32"
                                android:inputType="textPassword"
                                android:imeOptions="actionDone"
                                android:singleLine="true"
                                android:textColor="@color/prime_brand" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveAccount"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="20dp"
                            android:text="Сохранить"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:visibility="gone"
                            app:backgroundTint="@color/prime_brand"
                            app:cornerRadius="12dp"
                            app:elevation="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Разделитель "Настройки" с линиями -->
                <LinearLayout
                    android:id="@+id/layoutSettingsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginHorizontal="24dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/prime_brand_dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:text="Настройки"
                        android:textColor="@color/prime_brand"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/prime_brand_dark" />
                </LinearLayout>

                <!-- Блок настроек (тумблеры) -->
                <LinearLayout
                    android:id="@+id/layoutSwitches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="24dp"
                    android:orientation="vertical">

                    <!-- Тема оформления -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="@color/prime_surface"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Тема оформления"
                                android:textColor="@color/prime_brand"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvThemeSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Системная"
                                android:textColor="@color/prime_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Анимации -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="@color/prime_surface"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchAnimations"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Анимации интерфейса"
                                android:textColor="@color/prime_brand"
                                android:textStyle="bold"
                                android:checked="true"
                                app:showText="false" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Включает плавные переходы и визуальные эффекты в приложении"
                                android:textColor="@color/prime_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                <!-- Живой фон -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/prime_surface"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchLavaBg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Живой фон"
                            android:textColor="@color/prime_brand"
                            android:textStyle="bold"
                            android:checked="true"
                            app:showText="false" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Анимированные фигуры на фоне экрана настроек"
                            android:textColor="@color/prime_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                    <!-- Чёрный список -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="@color/prime_surface"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchBlocked"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Чёрный список"
                                android:textColor="@color/prime_brand"
                                android:textStyle="bold"
                                app:showText="false" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Управление списком заблокированных контактов и пользователей"
                                android:textColor="@color/prime_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Скрыть поиск -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="@color/prime_surface"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchSearch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Скрыть поиск"
                                android:textColor="@color/prime_brand"
                                android:textStyle="bold"
                                app:showText="false" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Скрывает строку поиска на главном экране чатов"
                                android:textColor="@color/prime_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="Prime v1.0.0"
                    android:textColor="@color/prime_brand"
                    android:alpha="0.4"
                    android:textSize="12sp"
                    android:layout_gravity="center_horizontal" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurWallpaperPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_island"
        android:outlineProvider="background"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Драг хэндл для шторки -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/ic_drag_handle"
                android:backgroundTint="#40FFFFFF" />

            <!-- Заголовок и подзаголовок -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_photo"
                    app:tint="@color/prime_brand" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPickerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Обои чата"
                        android:textColor="@color/prime_text_primary"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvPickerSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Индивидуальный фон собеседника"
                        android:textColor="@color/prime_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvActiveWallpaperBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Стандартные"
                    android:textColor="@color/prime_brand"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1AFFFFFF"
                android:layout_marginBottom="14dp"/>

            <!-- Горизонтальная прокрутка вариантов обоев -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWallpaperOptions"
                android:layout_width="match_parent"
                android:layout_height="185dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_wallpaper_picker" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- Кнопка установить для этого чата -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyForChat"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Применить для этого чата"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:backgroundTint="@color/prime_brand"
                    app:icon="@drawable/ic_done"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />

                <!-- Кнопка применить для всех чатов -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyGlobal"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Применить для всех чатов"
                    android:textAllCaps="false"
                    android:textColor="@color/prime_text_primary"
                    android:textSize="14sp"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/prime_divider"
                    app:strokeWidth="1dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Кнопка создания / редактора обоев -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenEditor"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Создать обои"
                        android:textAllCaps="false"
                        android:textColor="@color/prime_brand"
                        android:textSize="13sp"
                        app:backgroundTint="@android:color/transparent"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart"
                        app:iconTint="@color/prime_brand" />

                    <!-- Кнопка сброса персональных обоев -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetContactWallpaper"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="Сбросить обои"
                        android:textAllCaps="false"
                        android:textColor="@color/prime_danger"
                        android:textSize="13sp"
                        app:backgroundTint="@android:color/transparent"
                        app:icon="@drawable/ic_trash"
                        app:iconGravity="textStart"
                        app:iconTint="@color/prime_danger" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurDialogCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_island"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:id="@+id/ivDialogIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Иконка диалога"
                android:visibility="gone"
                android:src="@drawable/ic_person"
                app:tint="@color/prime_brand" />

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/dialog_title_color"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Заголовок" />

            <TextView
                android:id="@+id/tvDialogMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/dialog_body_color"
                android:textSize="14sp"
                tools:text="Текст сообщения диалога" />

            <FrameLayout
                android:id="@+id/dialogCustomViewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDialogNegative"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Нет"
                    android:textColor="@color/dialog_button_cancel_text"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/dialog_button_cancel_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDialogPositive"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/prime_brand"
                    android:text="Да"
                    android:textColor="@color/white"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>
</FrameLayout>

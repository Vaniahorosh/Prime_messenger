<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurDialogCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_island"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/ivDialogIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Иконка диалога"
                android:visibility="gone"
                android:src="@drawable/ic_person"
                app:tint="@color/prime_brand" />

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/dialog_title_color"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Заголовок" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxHeight="320dp"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDialogMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:textColor="@color/dialog_body_color"
                        android:textSize="13.5sp"
                        android:lineSpacingExtra="3dp"
                        tools:text="Текст сообщения диалога" />

                    <FrameLayout
                        android:id="@+id/dialogCustomViewContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDialogNegative"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Нет"
                    android:textColor="@color/dialog_button_cancel_text"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/dialog_button_cancel_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDialogPositive"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/prime_brand"
                    android:text="Да"
                    android:textColor="@color/white"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>
</FrameLayout>

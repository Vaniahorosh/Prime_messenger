<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/prime_base"
    android:paddingHorizontal="24dp"
    android:paddingVertical="32dp">

    <!-- Central Ban Card -->
    <LinearLayout
        android:id="@+id/cardBanContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside">

        <!-- Icon container -->
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_circular_mode_active"
            android:backgroundTint="@color/prime_surface">

            <ImageView
                android:id="@+id/ivBanIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ban_icon"
                android:contentDescription="Статус блокировки" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvBanTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/prime_text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            tools:text="Дмитрий, аккаунт заблокирован" />

        <TextView
            android:id="@+id/tvBanReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/prime_text_secondary"
            android:textSize="14sp"
            tools:text="Причина: Подозрительная активность" />

        <LinearLayout
            android:id="@+id/layoutBanDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_m3_active_indicator"
            android:backgroundTint="@color/prime_surface"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvBanDurationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/prime_text_secondary"
                android:textSize="14sp"
                android:text="Срок блокировки: " />

            <TextSwitcher
                android:id="@+id/tsBanTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:inAnimation="@anim/slide_in_top_alpha"
                android:outAnimation="@anim/slide_out_bottom" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBanExpiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/prime_text_secondary"
            android:textSize="13sp"
            tools:text="Блокировка истекает: 31.07.2026 14:00" />

    </LinearLayout>

    <!-- Bottom Actions -->
    <LinearLayout
        android:id="@+id/layoutBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBanAction"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/prime_danger_light"
            tools:text="Выйти из приложения" />

        <TextView
            android:id="@+id/tvDeleteWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Все данные аккаунта будут удалены"
            android:textColor="@color/prime_text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

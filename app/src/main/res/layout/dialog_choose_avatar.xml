<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_glass_card">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Изменить фото профиля"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Выбрать из галереи"
        app:icon="@drawable/ic_photo"
        app:backgroundTint="#20FFFFFF"
        android:textColor="@color/white"
        app:cornerRadius="12dp"
        app:iconTint="@color/white"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Готовые аватары"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAv1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="#20FFFFFF"
            android:src="@drawable/avatar_1"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/SquareFABShape" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAv2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="#20FFFFFF"
            android:src="@drawable/avatar_2"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/SquareFABShape" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAv3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="#20FFFFFF"
            android:src="@drawable/avatar_3"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/SquareFABShape" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAv4"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="#20FFFFFF"
            android:src="@drawable/avatar_4"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/SquareFABShape" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAv5"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="#20FFFFFF"
            android:src="@drawable/avatar_5"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/SquareFABShape" />
    </LinearLayout>
</LinearLayout>
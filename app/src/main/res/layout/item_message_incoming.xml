<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        android:id="@+id/tvDateHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_date_bubble"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="@color/chat_date_bubble_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Разделитель "Новое сообщение" -->
    <LinearLayout
        android:id="@+id/layoutUnreadHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <View
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_weight="1"
            android:background="@color/prime_brand" />

        <TextView
            android:id="@+id/tvUnreadTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:text="Новое сообщение"
            android:textColor="@color/prime_brand"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_weight="1"
            android:background="@color/prime_brand" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutIncomingBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="64dp"
        android:background="@drawable/bg_bubble_incoming"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Медиа Контейнер (1 элемент, 2 элемента сетка, 3-5 слайдер) -->
        <FrameLayout
            android:id="@+id/layoutMediaContainer"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <!-- Вариант 1: Одиночный медиа файл (1 элемент) -->
            <FrameLayout
                android:id="@+id/layoutSingleMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivMessageImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/Rounded16dpImageView" />

                <VideoView
                    android:id="@+id/videoMessagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:clickable="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivVideoPlayBadge"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circular_mode_active"
                    android:contentDescription="Воспроизвести"
                    android:padding="10dp"
                    android:src="@drawable/ic_media_play"
                    android:visibility="gone"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvVideoDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="6dp"
                    android:background="#99000000"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Вариант 2: Сетка для 2 элементов -->
            <LinearLayout
                android:id="@+id/layoutGridMedia"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/layoutGridTile1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivGridTile1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/Rounded16dpImageView" />

                    <ImageView
                        android:id="@+id/ivGridPlay1"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circular_mode_active"
                        android:contentDescription="Видео"
                        android:padding="6dp"
                        android:src="@drawable/ic_media_play"
                        android:visibility="gone"
                        app:tint="@color/white" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/layoutGridTile2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivGridTile2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/Rounded16dpImageView" />

                    <ImageView
                        android:id="@+id/ivGridPlay2"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circular_mode_active"
                        android:contentDescription="Видео"
                        android:padding="6dp"
                        android:src="@drawable/ic_media_play"
                        android:visibility="gone"
                        app:tint="@color/white" />
                </FrameLayout>
            </LinearLayout>

            <!-- Вариант 3: Слайдер (ViewPager2) для 3, 4, 5 элементов -->
            <FrameLayout
                android:id="@+id/layoutSliderMedia"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:visibility="gone">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpMediaSlider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvSliderIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_date_bubble"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="1 из 3" />
            </FrameLayout>
        </FrameLayout>

        <!-- Контейнер для обычных файлов -->
        <LinearLayout
            android:id="@+id/layoutFileContainer"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_pending_attachment"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivFileIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Файл"
                android:src="@drawable/ic_file"
                app:tint="@color/prime_brand" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/prime_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFileSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/prime_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/layoutFileDownloadArea"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp">

                <ImageButton
                    android:id="@+id/btnFileDownload"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Скачать"
                    android:src="@drawable/ic_download"
                    app:tint="@color/prime_brand" />

                <LinearLayout
                    android:id="@+id/layoutDownloadProgress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/pbDownloadProgress"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:indeterminate="true"
                        app:indicatorColor="@color/prime_brand"
                        app:indicatorSize="22dp"
                        app:trackThickness="2.5dp" />

                    <TextView
                        android:id="@+id/tvDownloadPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/prime_brand"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnCancelDownload"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Отменить"
                    android:src="@drawable/ic_cancel"
                    android:visibility="gone"
                    app:tint="@color/prime_danger" />
            </FrameLayout>
        </LinearLayout>

        <!-- Цитата ответа на другое сообщение -->
        <LinearLayout
            android:id="@+id/layoutQuotedReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_quoted_reply"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:padding="6dp"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:background="@color/prime_brand" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvQuotedSender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/prime_brand"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvQuotedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/prime_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:linksClickable="true"
            android:textColor="@color/chat_bubble_incoming_text"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/layoutLinkPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_quoted_reply"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:contentDescription="Ссылка"
                android:src="@drawable/ic_search"
                app:tint="@color/prime_brand" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLinkPreviewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/prime_brand"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLinkPreviewUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/prime_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Прогресс отправки/получения -->
        <LinearLayout
            android:id="@+id/layoutMessageProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbMessageProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/tvMessageProgressPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/prime_brand"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="45%" />

            <ImageButton
                android:id="@+id/btnCancelMessageSending"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Отменить"
                android:src="@drawable/ic_cancel"
                app:tint="@color/prime_danger" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:textColor="@color/chat_bubble_incoming_time"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutMessageReaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="-6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivReactionAvatar"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/CircleImageView" />

        <TextView
            android:id="@+id/tvMessageReaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Капсула быстрых действий (Реакции + Ответить) -->
    <LinearLayout
        android:id="@+id/layoutMessageActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_floating_island"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutDefaultActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnReactHeart"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="❤️"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnReactFire"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="🔥"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnReactLike"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="👍"
                android:textSize="16sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/prime_divider" />

            <ImageButton
                android:id="@+id/btnReplyMsgAction"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ответить"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_undo"
                app:tint="@color/prime_text_primary" />

            <ImageButton
                android:id="@+id/btnForwardMsgAction"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Переслать"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/prime_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutSelectionActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/btnReplySelectionAction"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Ответить на выделенное"
                    android:src="@drawable/ic_undo"
                    app:tint="@color/prime_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Ответить на выделенное"
                    android:textColor="@color/prime_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/prime_divider" />

            <LinearLayout
                android:id="@+id/btnCopySelectionAction"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Копировать"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/prime_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Копировать"
                    android:textColor="@color/prime_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>

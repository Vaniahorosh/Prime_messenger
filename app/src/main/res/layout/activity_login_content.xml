<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootConstraint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/loginBlurCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_card"
            app:blurOverlayColor="#00000000">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_back"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />

                <TextSwitcher
                    android:id="@+id/tsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btnBack" />

                <com.messenger.prime.OutlinedTextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Приветствуем!"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:visibility="gone"
                    tools:ignore="MissingConstraints" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Войдите в аккаунт, или введите желаемый логин для создания"
                    android:textColor="@color/white"
                    android:alpha="0.8"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tsTitle" />

                <!-- Avatar Container -->
                <FrameLayout
                    android:id="@+id/flAvatarContainer"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

                    <!-- Login Avatar Section -->
                    <FrameLayout
                        android:id="@+id/flLoginAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="visible">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivLoginAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_prime_logo_vector"
                            android:scaleType="centerCrop"
                            android:background="#1AFFFFFF"
                            app:shapeAppearanceOverlay="@style/RoundedDialogShape" />
                    </FrameLayout>

                    <!-- Registration Avatar Section -->
                    <FrameLayout
                        android:id="@+id/flRegisterAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivRegisterAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:background="#1AFFFFFF"
                            app:shapeAppearanceOverlay="@style/RoundedDialogShape" />

                        <TextView
                            android:id="@+id/tvSelectPhoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Выбрать\nфото"
                            android:textAlignment="center"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold"
                            android:layout_gravity="center" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Inputs Section (Centered) -->
                <LinearLayout
                    android:id="@+id/llInputs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/flAvatarContainer">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutLogin"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Логин"
                        app:boxBackgroundColor="#1AFFFFFF"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:boxStrokeColor="@color/white"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:hintTextColor="#94A3B8">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLogin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLength="25"
                            android:inputType="textNoSuggestions"
                            android:imeOptions="actionNext"
                            android:textColor="#94A3B8" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Ваше имя"
                        android:visibility="gone"
                        app:boxBackgroundColor="#1AFFFFFF"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:boxStrokeColor="@color/white"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:hintTextColor="#94A3B8">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLength="32"
                            android:inputType="textPersonName"
                            android:imeOptions="actionNext"
                            android:textColor="#94A3B8" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/llPasswordContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputLayoutPassword"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Пароль"
                            app:boxBackgroundColor="#1AFFFFFF"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="1dp"
                            app:boxStrokeColor="@color/white"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/white"
                            app:hintTextColor="#94A3B8">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:imeOptions="actionDone"
                                android:textColor="#94A3B8" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/btnSubmitArrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_gravity="center_vertical"
                            app:srcCompat="@drawable/ic_arrow_forward"
                            app:backgroundTint="#007BFF"
                            app:tint="@color/white"
                            app:fabSize="mini"
                            app:elevation="0dp"
                            app:shapeAppearanceOverlay="@style/RoundedDialogShape"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnToggleMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Регистрация"
                        app:backgroundTint="@color/prime_brand"
                        android:textColor="@color/white"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegisterSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Быть в прайме!"
                        android:visibility="gone"
                        app:backgroundTint="@color/prime_brand"
                        android:textColor="@color/white"
                        app:cornerRadius="16dp"
                        app:strokeColor="@color/prime_brand"
                        app:strokeWidth="2dp" />

                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_error_island"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:textAlignment="center" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/clBottomAvatars"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/llInputs">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvAvatarsHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Или выберите из 5 готовых аватаров"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="12sp" />
                        <View
                            android:id="@+id/vAvatarsLine"
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_weight="1"
                            android:background="?attr/colorPrimary"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivAvatar1"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:background="#20FFFFFF"
                            android:src="@drawable/avatar_1"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/SquareFABShape"
                            app:strokeColor="?attr/colorPrimary"
                            app:strokeWidth="2dp"/>
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivAvatar2"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:background="#20FFFFFF"
                            android:src="@drawable/avatar_2"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/SquareFABShape"
                            app:strokeColor="?attr/colorPrimary"
                            app:strokeWidth="2dp"/>
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivAvatar3"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:background="#20FFFFFF"
                            android:src="@drawable/avatar_3"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/SquareFABShape"
                            app:strokeColor="?attr/colorPrimary"
                            app:strokeWidth="2dp"/>
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivAvatar4"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:background="#20FFFFFF"
                            android:src="@drawable/avatar_4"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/SquareFABShape"
                            app:strokeColor="?attr/colorPrimary"
                            app:strokeWidth="2dp"/>
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivAvatar5"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="#20FFFFFF"
                            android:src="@drawable/avatar_5"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/SquareFABShape"
                            app:strokeColor="?attr/colorPrimary"
                            app:strokeWidth="2dp"/>
                    </LinearLayout>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </eightbitlab.com.blurview.BlurView>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:clipToOutline="true">

    <!-- 1. ЦЕНТРАЛЬНАЯ ЧАСТЬ: WebView заходит под верхнюю шапку и растягивается в самый низ -->
    <FrameLayout
        android:id="@+id/layoutWebViewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.messenger.prime.browser.ObservableWebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 2. ВЕРХНЯЯ ЧАСТЬ: Ручка шторки поверх WebView -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Ручка шторки с фоновым прогрессом -->
        <FrameLayout
            android:id="@+id/layoutBrowserHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="0dp"
                android:maxHeight="1000dp"
                android:max="100"
                android:progress="0"
                android:indeterminate="false"
                android:progressDrawable="@drawable/bg_browser_top_progress_bar" />

            <LinearLayout
                android:id="@+id/layoutBrowserHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="4dp"
                    android:src="@drawable/ic_drag_handle"
                    android:contentDescription="Drag Handle" />
            </LinearLayout>
        </FrameLayout>

        <!-- Поиск по странице (скрыт по умолчанию) -->
        <LinearLayout
            android:id="@+id/layoutFindInPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_block_gray"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="4dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/etFindQuery"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Поиск на странице..."
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:textColor="@color/prime_text_primary"
                android:textColorHint="@color/prime_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvFindMatches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="0/0"
                android:textColor="@color/prime_text_secondary"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/btnFindPrev"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@drawable/ic_arrow_up"
                app:tint="@color/prime_text_primary"
                android:contentDescription="Previous" />

            <ImageView
                android:id="@+id/btnFindNext"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/prime_text_primary"
                android:contentDescription="Next" />

            <ImageView
                android:id="@+id/btnFindClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                app:tint="@color/prime_text_secondary"
                android:contentDescription="Close" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. НИЖНЯЯ ПАНЕЛЬ: Плавающий островок с поддержкой BlurView -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/layoutBottomBarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_glass_island"
        android:elevation="14dp"
        android:outlineProvider="background"
        android:clipToOutline="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:background="@android:color/transparent">

            <!-- Заголовок страницы и SSL статус -->
            <LinearLayout
                android:id="@+id/layoutSiteInfoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/ivSecurityStatus"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_lock_closed"
                    app:tint="@color/prime_brand"
                    android:contentDescription="SSL Status" />

                <TextView
                    android:id="@+id/tvPageTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Загрузка..."
                    android:textColor="@color/prime_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Кнопки управления и строка поиска/URL -->
            <LinearLayout
                android:id="@+id/layoutControlsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/btnBackClose"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/prime_text_primary"
                    android:contentDescription="Back" />

                <ImageView
                    android:id="@+id/btnForward"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/prime_text_primary"
                    android:contentDescription="Forward" />

                <LinearLayout
                    android:id="@+id/cardAddressBar"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_settings_block_gray"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivAddressSearchIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_globe"
                        app:tint="@color/prime_text_secondary"
                        android:contentDescription="Search Icon" />

                    <EditText
                        android:id="@+id/etAddressInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="4dp"
                        android:background="@null"
                        android:hint="Поиск или URL..."
                        android:imeOptions="actionGo"
                        android:inputType="textUri"
                        android:selectAllOnFocus="true"
                        android:singleLine="true"
                        android:textColor="@color/prime_text_primary"
                        android:textColorHint="@color/prime_text_secondary"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/btnGoOrRefresh"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:padding="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/prime_text_primary"
                        android:contentDescription="Refresh" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/prime_text_primary"
                    android:contentDescription="Menu" />
            </LinearLayout>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    <!-- 4. ПЛАВАЮЩАЯ КНОПКА ВОЗВРАТА ПАНЕЛИ -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/btnRestorePanel"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass_island"
        android:elevation="16dp"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivRestoreIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_up"
            app:tint="@color/prime_text_primary"
            android:contentDescription="Restore Panel" />
    </eightbitlab.com.blurview.BlurView>
</androidx.constraintlayout.widget.ConstraintLayout>

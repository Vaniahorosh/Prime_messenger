<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurPermissionsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_island"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:elevation="16dp">

        <!-- Основной прокручиваемый контейнер для гарантии видимости на любых экранах -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Заголовок с иконкой -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_settings"
                        app:tint="#38BDF8" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Доступ к функциям Prime Messenger"
                        android:textColor="@color/prime_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Приложению нужны разрешения, чтобы вы могли комфортно общаться, отправлять файлы:"
                        android:textColor="@color/prime_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Список разрешений -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <!-- 1. Камера -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical">

                            <View
                                android:id="@+id/vPermShapeCamera"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:tag="do_not_tint" />

                            <ImageView
                                android:id="@+id/ivPermCamera"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="7dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_camera"
                                android:tag="do_not_tint"
                                app:tint="#38BDF8" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Камера"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Чтобы делать снимки, записывать видеосообщения и быстро обновлять аватарку."
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"
                                android:lineSpacingExtra="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 2. Микрофон -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical">

                            <View
                                android:id="@+id/vPermShapeMic"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:tag="do_not_tint" />

                            <ImageView
                                android:id="@+id/ivPermMic"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="7dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_mic"
                                android:tag="do_not_tint"
                                app:tint="#06B6D4" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Микрофон"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Чтобы отправлять голосовые сообщения, записывать видео в кружочках."
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"
                                android:lineSpacingExtra="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 3. Контакты -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical">

                            <View
                                android:id="@+id/vPermShapeContacts"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:tag="do_not_tint" />

                            <ImageView
                                android:id="@+id/ivPermContacts"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="7dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_person"
                                android:tag="do_not_tint"
                                app:tint="#4ADE80" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Контакты"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Чтобы легко находить знакомых из вашей телефонной книги и сразу начинать чат."
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"
                                android:lineSpacingExtra="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 4. Bluetooth и связь -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical">

                            <View
                                android:id="@+id/vPermShapeBluetooth"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:tag="do_not_tint" />

                            <ImageView
                                android:id="@+id/ivPermBluetooth"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="7dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_nav_devices"
                                android:tag="do_not_tint"
                                app:tint="#EAB308" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bluetooth и офлайн-чат"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Чтобы обмениваться сообщениями и файлами с людьми поблизости даже без интернета."
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"
                                android:lineSpacingExtra="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 5. Устройства поблизости -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical">

                            <View
                                android:id="@+id/vPermShapeSearch"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:tag="do_not_tint" />

                            <ImageView
                                android:id="@+id/ivPermSearch"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="7dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_search"
                                android:tag="do_not_tint"
                                app:tint="#38BDF8" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Поиск устройств"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Необходимо системе Android для безопасного поиска собеседников рядом с вами."
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"
                                android:lineSpacingExtra="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 6. Уведомления -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical">

                            <View
                                android:id="@+id/vPermShapeNotifications"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:tag="do_not_tint" />

                            <ImageView
                                android:id="@+id/ivPermNotifications"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="7dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_notifications"
                                android:tag="do_not_tint"
                                app:tint="#F43F5E" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Уведомления"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Чтобы вы не пропустили важные сообщения и могли быстро отвечать из шторки."
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"
                                android:lineSpacingExtra="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 7. Галерея и медиафайлы -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical">

                            <View
                                android:id="@+id/vPermShapeMedia"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:tag="do_not_tint" />

                            <ImageView
                                android:id="@+id/ivPermMedia"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="7dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_photo"
                                android:tag="do_not_tint"
                                app:tint="#A855F7" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Фото, видео и файлы"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Чтобы отправлять в чаты и сохранять к себе фотографии, видео, музыку и документы."
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"
                                android:lineSpacingExtra="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <!-- Нижний блок кнопок (скроллится вместе с контентом) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <!-- 1. Главная кнопка -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAcceptAllPermissions"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:backgroundTint="@color/chat_bubble_outgoing_start"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:tag="do_not_tint"
                        android:text="Разрешить все"
                        android:textColor="@color/white"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_done"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconTint="@color/white" />

                    <!-- 2. Ряд из двух компактных кнопок -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <!-- Вторичная кнопка: Пропустить / Позже -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnContinueWithoutPermissions"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="4dp"
                            android:tag="do_not_tint"
                            android:text="Пропустить"
                            android:textColor="@color/white"
                            android:textSize="12.5sp"
                            app:cornerRadius="10dp"
                            app:strokeColor="#80FFFFFF"
                            app:strokeWidth="1dp" />

                        <!-- Третичная кнопка: Выйти -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExitApp"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="4dp"
                            android:tag="do_not_tint"
                            android:text="Выйти"
                            android:textColor="#EF4444"
                            android:textSize="12.5sp"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_cancel"
                            app:iconGravity="textStart"
                            app:iconSize="15dp"
                            app:iconTint="#EF4444" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </eightbitlab.com.blurview.BlurView>
</FrameLayout>

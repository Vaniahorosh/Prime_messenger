<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/prime_base">

    <!-- Live Animated Wallpaper Background for Placeholder -->
    <com.messenger.prime.MaterialShapesWallpaperView
        android:id="@+id/vRightPaneWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Clickable Ai Badge (Unslopped Empty State) -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurRightPaneEmpty"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_blur_glass_panel"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_prime_ai"
                app:tint="@color/prime_brand"
                android:contentDescription="Ai" />

        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

</FrameLayout>

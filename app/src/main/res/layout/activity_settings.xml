<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".SettingsActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="40dp">

            <!-- Шапка с фирменным цветом -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerStaticBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#154B87"
                android:elevation="4dp"
                android:paddingBottom="24dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Режим с ФОТО -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutWithPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Кнопка Назад (Размер 56dp, Иконка по центру) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackWP"
                        style="@style/Widget.MaterialComponents.Button.Icon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="27dp"
                        android:backgroundTint="@color/glass_white_20"
                        android:padding="0dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_arrow_back"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="24dp"
                        app:iconTint="@color/white"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvBackLabelWP"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Назад"
                        android:textColor="@color/white"
                        android:alpha="0.8"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@id/btnBackWP"
                        app:layout_constraintEnd_toEndOf="@id/btnBackWP"
                        app:layout_constraintTop_toBottomOf="@id/btnBackWP" />

                    <!-- Левая колонка кнопок (Размер 56dp, Иконки по центру) -->
                    <LinearLayout
                        android:id="@+id/layoutLeftColumn"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvBackLabelWP"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChangePhoto"
                            style="@style/Widget.MaterialComponents.Button.Icon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginBottom="2dp"
                            android:backgroundTint="@color/glass_white_20"
                            android:padding="0dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_add"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="24dp"
                            app:iconTint="@color/white" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Фото"
                            android:textColor="@color/white"
                            android:alpha="0.8"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLogout"
                            style="@style/Widget.MaterialComponents.Button.Icon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginBottom="2dp"
                            android:backgroundTint="@color/glass_white_20"
                            android:padding="0dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_exit_to_app"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="24dp"
                            app:iconTint="#FF8A80" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Выход"
                            android:textColor="#FFCDD2"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExtraSettings"
                            style="@style/Widget.MaterialComponents.Button.Icon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginBottom="2dp"
                            android:backgroundTint="@color/glass_white_20"
                            android:padding="0dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_settings"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="24dp"
                            app:iconTint="@color/white" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Настройки"
                            android:textColor="@color/white"
                            android:alpha="0.8"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Карточка с фото -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/photoCard"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginEnd="16dp"
                        app:cardBackgroundColor="@color/glass_white_10"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/layoutLeftColumn"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/layoutLeftColumn"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <androidx.compose.ui.platform.ComposeView
                                android:id="@+id/composePhotoCard"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <!-- Контейнер для текста, который мы будем инверсно скалировать в коде -->
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/layoutPhotoInternal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <View
                                    android:id="@+id/viewPhotoInfoGradient"
                                    android:layout_width="match_parent"
                                    android:layout_height="90dp"
                                    android:background="@drawable/bg_photo_info_gradient"
                                    app:layout_constraintBottom_toBottomOf="parent" />

                                <TextView
                                    android:id="@+id/tvUserNameWP"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_marginEnd="16dp"
                                    android:layout_marginBottom="2dp"
                                    android:textColor="@color/white"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:singleLine="true"
                                    android:ellipsize="marquee"
                                    android:marqueeRepeatLimit="marquee_forever"
                                    android:scrollHorizontally="true"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    app:layout_constraintBottom_toTopOf="@+id/tvStatusWP"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent" />

                                <TextView
                                    android:id="@+id/tvStatusWP"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="12dp"
                                    android:text="в сети"
                                    android:textColor="#E6FFFFFF"
                                    android:textSize="12sp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="@+id/tvUserNameWP" />
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Режим БЕЗ фото -->
                <LinearLayout
                    android:id="@+id/layoutNoPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvUserNameStatic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="32dp"
                        android:text="в сети"
                        android:textColor="#E6FFFFFF"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBackNP"
                                style="@style/Widget.MaterialComponents.Button.Icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:backgroundTint="@color/glass_white_20"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_arrow_back"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="24dp"
                                app:iconTint="@color/white" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Назад"
                                android:textColor="@color/white"
                                android:alpha="0.8"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnChangePhotoNP"
                                style="@style/Widget.MaterialComponents.Button.Icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:backgroundTint="@color/glass_white_20"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_add"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="24dp"
                                app:iconTint="@color/white" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Фото"
                                android:textColor="@color/white"
                                android:alpha="0.8"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLogoutNP"
                                style="@style/Widget.MaterialComponents.Button.Icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:backgroundTint="@color/glass_white_20"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_exit_to_app"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="24dp"
                                app:iconTint="#FF8A80" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Выход"
                                android:textColor="#FFCDD2"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnExtraSettingsNP"
                                style="@style/Widget.MaterialComponents.Button.Icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:backgroundTint="@color/glass_white_20"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_settings"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="24dp"
                                app:iconTint="@color/white" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Опции"
                                android:textColor="@color/white"
                                android:alpha="0.8"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Данные аккаунта (СТАРЫЙ ВАРИАНТ) -->
            <LinearLayout
                android:id="@+id/layoutAccountData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="24dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_settings_card_white"
                app:layout_constraintTop_toBottomOf="@+id/headerStaticBlock">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Логин"
                    android:textColor="#154B87"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutLogin"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="#0D154B87"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="1.5dp"
                    app:boxStrokeColor="#154B87"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#154B87">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSettingsLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="#154B87"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="Пароль"
                    android:textColor="#154B87"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="#0D154B87"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="1.5dp"
                    app:boxStrokeColor="#154B87"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#154B87">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSettingsPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="#154B87" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveAccount"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:text="Сохранить"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="#154B87"
                    app:cornerRadius="12dp"
                    app:elevation="4dp" />
            </LinearLayout>

            <!-- Блок настроек (СТАРЫЙ ВАРИАНТ) -->
            <LinearLayout
                android:id="@+id/layoutSwitches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="24dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_settings_card_white"
                app:layout_constraintTop_toBottomOf="@+id/layoutAccountData">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAnimations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Анимации интерфейса"
                    android:textColor="#154B87"
                    app:thumbTint="#154B87"
                    app:trackTint="#4D154B87"
                    android:checked="true" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#0D154B87" android:layout_marginHorizontal="12dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchBlocked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Чёрный список"
                    android:textColor="#154B87"
                    app:thumbTint="#154B87"
                    app:trackTint="#4D154B87" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#0D154B87" android:layout_marginHorizontal="12dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Скрыть поиск"
                    android:textColor="#154B87"
                    app:thumbTint="#154B87"
                    app:trackTint="#4D154B87" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Prime v1.0.0"
                android:textColor="#154B87"
                android:alpha="0.4"
                android:textSize="12sp"
                app:layout_constraintTop_toBottomOf="@+id/layoutSwitches"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/dialogContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="200dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

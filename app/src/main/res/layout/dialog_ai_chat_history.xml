<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurViewHistorySheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_blur_glass_panel"
        android:clipToOutline="true"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Top Drag Handle Indicator -->
            <View
                android:layout_width="38dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_date_bubble"
                android:alpha="0.6" />

            <!-- Sheet Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/ivHeaderIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_clock"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="История" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="История чатов"
                    android:textColor="@color/prime_text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- "Новый чат" Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateNewChat"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Новый чат"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="13.5sp"
                    android:letterSpacing="0.01"
                    android:textAllCaps="false"
                    app:cornerRadius="20dp"
                    app:backgroundTint="?attr/colorPrimary"
                    app:icon="@drawable/ic_add"
                    app:iconTint="?attr/colorOnPrimary"
                    app:iconSize="18dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/prime_divider"
                android:alpha="0.3"
                android:layout_marginBottom="10dp" />

            <!-- Empty History Notice -->
            <TextView
                android:id="@+id/tvEmptyHistoryNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:gravity="center"
                android:text="Нет сохраненных чатов.\nНажмите 'Новый чат', чтобы начать диалог!"
                android:textColor="@color/prime_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Saved Chats List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAiChatHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="380dp"
                android:overScrollMode="never"
                tools:listitem="@layout/item_ai_chat_history" />

        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>
</LinearLayout>
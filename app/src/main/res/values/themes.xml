<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Prime" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/prime_brand</item>
        <item name="colorAccent">@color/prime_brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/prime_brand_alpha_80</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/prime_brand</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/prime_search_bg</item>
        <item name="colorOnSecondaryContainer">@color/prime_text_primary</item>
        <item name="android:windowBackground">@color/prime_base</item>
        <item name="android:colorBackground">@color/prime_base</item>
        <item name="colorSurface">@color/prime_base</item>
        <item name="colorOnSurface">@color/prime_text_primary</item>
        <item name="colorSurfaceVariant">@color/prime_surface</item>
        <item name="colorOnSurfaceVariant">@color/prime_text_secondary</item>
        <item name="colorSurfaceContainerHigh">@color/chat_island_bg</item>
        <item name="colorOutline">@color/prime_divider</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Material 3 Expressive attributes -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Material3.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Material3.HeadlineMedium</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Material3.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Material3.BodyLarge</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Material3.LabelLarge</item>

        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Material3.Expressive.ExtraLarge</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Material3.Expressive.Large</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Material3.Expressive.Medium</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Material3.Expressive.Small</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Material3.Expressive.Large</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Material3.Expressive.Medium</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Material3.Expressive.Small</item>

        <item name="materialAlertDialogTheme">@style/Theme.Prime.AlertDialog</item>
    </style>

    <style name="ShapeAppearance.Material3.Expressive.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.Material3.Expressive.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.Material3.Expressive.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearance.Material3.Expressive.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Theme.Prime.Swipe" parent="Theme.Prime">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <style name="SquareFABShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Rounded15PercentImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24%</item>
    </style>

    <style name="Rounded16dpImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Theme.Prime.PhotoViewer" parent="Theme.Prime.Swipe">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Стиль для всех диалогов в стиле Prime Glassmorphism -->
    <style name="Theme.Prime.AlertDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/prime_brand</item>
        <item name="colorAccent">@color/prime_brand</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorSurface">@color/chat_island_bg</item>
        <item name="android:colorBackground">@color/chat_island_bg</item>
        <item name="dialogCornerRadius">26dp</item>
        <item name="shapeAppearanceMediumComponent">@style/RoundedDialogShape</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.Prime.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Widget.Prime.Dialog.Body</item>
        <item name="android:textColorPrimary">@color/dialog_title_color</item>
        <item name="android:textColorSecondary">@color/dialog_body_color</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Prime.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Prime.Button.Dialog.Negative</item>
    </style>

    <style name="RoundedDialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>
    </style>

    <style name="Widget.Prime.Dialog.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/dialog_title_color</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Prime.Dialog.Body" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/dialog_body_color</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.Prime.Button.Dialog" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/dialog_button_cancel_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Prime.Button.Dialog.Negative" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/prime_danger</item>
    </style>

    <style name="EditorToolButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Theme Overlays for Custom Color Accents -->
    <style name="ThemeOverlay.Prime.Emerald" parent="">
        <item name="colorPrimary">#00897B</item>
        <item name="colorAccent">#00897B</item>
        <item name="colorPrimaryContainer">#CC00897B</item>
        <item name="colorSecondary">#00897B</item>
    </style>

    <style name="ThemeOverlay.Prime.Purple" parent="">
        <item name="colorPrimary">#7C4DFF</item>
        <item name="colorAccent">#7C4DFF</item>
        <item name="colorPrimaryContainer">#CC7C4DFF</item>
        <item name="colorSecondary">#7C4DFF</item>
    </style>

    <style name="ThemeOverlay.Prime.Amber" parent="">
        <item name="colorPrimary">#FB8C00</item>
        <item name="colorAccent">#FB8C00</item>
        <item name="colorPrimaryContainer">#CCFB8C00</item>
        <item name="colorSecondary">#FB8C00</item>
    </style>

    <style name="ThemeOverlay.Prime.Ruby" parent="">
        <item name="colorPrimary">#E53935</item>
        <item name="colorAccent">#E53935</item>
        <item name="colorPrimaryContainer">#CCE53935</item>
        <item name="colorSecondary">#E53935</item>
    </style>

    <style name="ThemeOverlay.Prime.Cyan" parent="">
        <item name="colorPrimary">#00ACC1</item>
        <item name="colorAccent">#00ACC1</item>
        <item name="colorPrimaryContainer">#CC00ACC1</item>
        <item name="colorSecondary">#00ACC1</item>
    </style>

    <style name="ThemeOverlay.Prime.Pink" parent="">
        <item name="colorPrimary">#E91E63</item>
        <item name="colorAccent">#E91E63</item>
        <item name="colorPrimaryContainer">#CCE91E63</item>
        <item name="colorSecondary">#E91E63</item>
    </style>
</resources>

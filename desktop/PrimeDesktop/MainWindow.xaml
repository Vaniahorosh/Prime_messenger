<Window x:Class="PrimeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PrimeDesktop.ViewModels"
        xmlns:conv="clr-namespace:PrimeDesktop.Converters"
        Title="Prime Messenger" Height="720" Width="1100"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ConnectionStateColorConverter x:Key="StateColorConverter"/>
        <conv:MessageAlignmentConverter x:Key="MsgAlignConverter"/>
        <conv:MessageBubbleBrushConverter x:Key="MsgBubbleConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/> <!-- Custom TitleBar -->
            <RowDefinition Height="*"/>  <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- Custom Windows 11 TitleBar -->
        <Grid Grid.Row="0" Background="{StaticResource HeaderBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Title & Icon -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Border Width="18" Height="18" CornerRadius="4" Background="{StaticResource AccentBrush}" Margin="0,0,8,0">
                    <TextBlock Text="P" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Prime Messenger" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Window Control Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="—" Style="{StaticResource ModernButton}" BorderThickness="0" Width="44" Height="36" Padding="0" Click="BtnMinimize_Click"/>
                <Button Content="□" Style="{StaticResource ModernButton}" BorderThickness="0" Width="44" Height="36" Padding="0" Click="BtnMaximize_Click"/>
                <Button Content="✕" Style="{StaticResource ModernButton}" BorderThickness="0" Width="44" Height="36" Padding="0" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- 3-Column Main Layout Grid -->
        <Grid Grid.Row="1" x:Name="MainContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="260" MaxWidth="450"/> <!-- Col 0: Sidebar -->
                <ColumnDefinition Width="*"/>                                   <!-- Col 1: Chat View -->
            </Grid.ColumnDefinitions>

            <!-- Column 0: Left Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- User Header & Actions -->
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="*"/>    <!-- Chats List -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
                    </Grid.RowDefinitions>

                    <!-- User Header & Top Actions -->
                    <DockPanel Grid.Row="0" Margin="14,14,14,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="📡" Style="{StaticResource ModernButton}" ToolTip="Скан Bluetooth" Command="{Binding ScanDevicesCommand}" Margin="0,0,4,0" Width="34" Height="34" Padding="0"/>
                            <Button Content="🔗" Style="{StaticResource ModernButton}" ToolTip="Связка с телефоном по Wi-Fi" Command="{Binding ConnectCompanionWifiCommand}" Margin="0,0,4,0" Width="34" Height="34" Padding="0"/>
                            <Button Content="⚙" Style="{StaticResource ModernButton}" ToolTip="Настройки" Command="{Binding ToggleSettingsCommand}" Width="34" Height="34" Padding="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentBrush}">
                                <TextBlock Text="U" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Settings.MyDisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Search Box -->
                    <Grid Grid.Row="1" Margin="14,0,14,10">
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="32,8,10,8"/>
                        <TextBlock Text="🔍" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Chats List -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredChats}" SelectedItem="{Binding SelectedChat}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="6,2" CornerRadius="8" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar with State Dot -->
                                        <Grid Grid.Column="0" Margin="0,0,10,0">
                                            <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource CardBrush}">
                                                <TextBlock Text="{Binding Initials}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                     Fill="{Binding ConnectionState, Converter={StaticResource StateColorConverter}}"/>
                                        </Grid>

                                        <!-- Name & Last Message -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding LastMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Time & Unread Badge -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LastMessageTime}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                            <Border Background="{StaticResource BadgeBrush}" CornerRadius="10" MinWidth="18" Height="18" Margin="0,4,0,0"
                                                    Visibility="{Binding UnreadCount, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Status Bar -->
                    <Border Grid.Row="3" Background="{StaticResource HeaderBrush}" Padding="12,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Border>
            <!-- Column 1: Chat View -->
            <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/> <!-- Chat Header -->
                    <RowDefinition Height="*"/>  <!-- Messages Scroll Area -->
                    <RowDefinition Height="Auto"/> <!-- Reply Bar & Input Area (Step 4) -->
                </Grid.RowDefinitions>

                <!-- Chat Header -->
                <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                    <DockPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Подключить" Style="{StaticResource ModernButton}" Command="{Binding ConnectChatCommand}" Margin="0,0,6,0" FontSize="12"/>
                            <Button Content="Отключить" Style="{StaticResource ModernButton}" Command="{Binding DisconnectChatCommand}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource CardBrush}" Margin="0,0,12,0">
                                <TextBlock Text="{Binding SelectedChat.Initials}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedChat.DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Печатает..." Foreground="{StaticResource AccentBrush}" FontSize="12"
                                           Visibility="{Binding SelectedChat.IsTyping, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Messages Scroll Area -->
                <ScrollViewer Grid.Row="1" x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto" Padding="16">
                    <ItemsControl ItemsSource="{Binding SelectedChat.Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" HorizontalAlignment="{Binding IsFromMe, Converter={StaticResource MsgAlignConverter}}">
                                    <Border Background="{Binding IsFromMe, Converter={StaticResource MsgBubbleConverter}}"
                                            CornerRadius="12" Padding="12,8" MaxWidth="520">
                                        <StackPanel>
                                            <!-- Quoted Reply Banner -->
                                            <Border Background="#20FFFFFF" CornerRadius="6" Padding="8,4" Margin="0,0,0,6"
                                                    Visibility="{Binding HasReply, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ReplyToSender}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ReplyToText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- File Attachment Banner -->
                                            <Border Background="#20000000" CornerRadius="6" Padding="8,4" Margin="0,0,0,6"
                                                    Visibility="{Binding HasAttachment, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Message Text & Time -->
                                            <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding FormattedTime}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- Row 2: Reply Bar & Message Input Area -->
                <Border Grid.Row="2" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                    <StackPanel>
                        <!-- Active Reply Banner -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,8"
                                Visibility="{Binding HasReply, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button Content="✕" Style="{StaticResource ModernButton}" Command="{Binding CancelReplyCommand}" DockPanel.Dock="Right" Width="24" Height="24" Padding="0"/>
                                <StackPanel>
                                    <TextBlock Text="Ответ на сообщение:" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ReplyMessage.Text}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Input Controls Row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Attachments -->
                                <ColumnDefinition Width="*"/>    <!-- Text Box -->
                                <ColumnDefinition Width="Auto"/> <!-- Send Button -->
                            </Grid.ColumnDefinitions>

                            <!-- Attachment Buttons -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                <Button Content="📷" Style="{StaticResource ModernButton}" ToolTip="Отправить фото" Command="{Binding AttachPhotoCommand}" Width="36" Height="36" Padding="0" Margin="0,0,4,0"/>
                                <Button Content="📎" Style="{StaticResource ModernButton}" ToolTip="Отправить файл" Command="{Binding AttachFileCommand}" Width="36" Height="36" Padding="0"/>
                            </StackPanel>

                            <!-- Message Text Input -->
                            <TextBox Grid.Column="1" x:Name="MsgInputTextBox" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding InputMessageText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="MsgInputTextBox_PreviewKeyDown"
                                     VerticalAlignment="Center" MinHeight="36" MaxHeight="100" TextWrapping="Wrap"/>

                            <!-- Send Button -->
                            <Button Grid.Column="2" Content="➤" Style="{StaticResource AccentButton}" ToolTip="Отправить (Enter)"
                                    Command="{Binding SendMessageCommand}" Width="40" Height="36" Padding="0" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
